##
## File: ddc_server.opt
## Descrption: ddc_daemon server-options file; see ddc_server.opt(5)


LogLevel		info
#NumThreads		4
#NumThreads		2
NumThreads		0
ThreadQueueSize		256

#SlowQueryTimeout	5
#SlowQueryTimeout	1

#StatsWindow: obsolete since v2.1.15-pre1
#StatsWindow		10

NavCacheSize		3
NavCacheStep		20

# compat <= v2.1.8: disable navcache hints for 'get_first_hits' requests sent by server (4- and 5-argument forms of 'get_first_hits')
#VersionCompat		2.1.8

