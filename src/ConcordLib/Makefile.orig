
include ../common/common_mak
LibName = libConcord$(ct)


objects = unix_simple_qparse.o$(ct) \
unix_simple_qlex.o$(ct)  \
ConcordAlgorithm.o$(ct) \
QueryNode.o$(ct)  \
ConcBigrams.o$(ct)  \
QueryParser.o$(ct) \
ConcHolder.o$(ct) \
CocnordQuery.o$(ct) \
Bibliography.o$(ct)  \
ConcordUnion.o$(ct) \
HitBorder.o$(ct) \
ConcordBibl.o$(ct) \
IndexMorphXml.o$(ct) \
IndexSet.o$(ct) \
StringIndexator.o$(ct) \
ConcIndexator.o$(ct) \
ConcordOptions.o$(ct) \
IndexSetForLoadingStage.o$(ct) \
IndexSetForQueryingStage.o$(ct) \
ConvertFromLoadIndexToWorking.o$(ct) \
LoadingBinaries.o$(ct) \
../PCRE/pcre_rml.o$(ct) \
../common/MorphXmlToken.o$(ct) \
../common/DwdsThesaurus.o$(ct)




include ../common/common_lib_mak


unix_simple_qparse.cpp unix_simple_qparse.h : simple_query.y
	bison -d  -ounix_simple_qparse_tmp.cpp simple_query.y
	sed -f ../common/process_yacc.sed < unix_simple_qparse_tmp.cpp  > unix_simple_qparse.cpp
	test -f unix_simple_qparse_tmp.hpp && mv unix_simple_qparse_tmp.hpp  unix_simple_qparse.h
	-rm unix_simple_qparse_tmp.cpp

unix_simple_qlex.cpp : simple_query.l unix_simple_qparse.h
	flex -Psim -ounix_simple_qlex.cpp -d simple_query.l 
	##flex -Psim -os_qlex.cpp.tmp -d simple_query.l 
	##sed -f ../common/process_flex.sed < s_qlex.cpp.tmp > unix_simple_qlex.cpp 

clean: ;
	-rm -f s_qlex.cpp.tmp
	-rm -f unix_simple_qparse.cpp
	-rm -f unix_simple_qparse.h
	-rm -f unix_simple_qlex.cpp
	-rm -f *.o$(ct)
	-rm -f $(LibName)
	-rm -f *.d
