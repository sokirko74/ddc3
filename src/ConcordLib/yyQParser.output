Grammar

    0 $accept: query $end

    1 query: q_clause q_filters

    2 q_filters: /* empty */
    3          | q_filters q_flag
    4          | q_filters q_filter

    5 q_flag: ':' qf_subcorpora
    6       | CNTXT integer
    7       | WITHIN symbol
    8       | FILENAMES_ONLY
    9       | '!' FILENAMES_ONLY
   10       | DEBUG_RANK
   11       | '!' DEBUG_RANK

   12 qf_subcorpora: /* empty */
   13              | s_subcorpus
   14              | qf_subcorpora ',' s_subcorpus

   15 q_filter: qf_has_field
   16         | qf_rank_sort
   17         | qf_bigram_sort
   18         | qf_size_sort
   19         | qf_date_sort
   20         | qf_bibl_sort
   21         | qf_random_sort

   22 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   23             | HAS_FIELD '[' symbol ',' regex ']'
   24             | HAS_FIELD '[' symbol ',' neg_regex ']'
   25             | HAS_FIELD '[' symbol ',' s_prefix ']'
   26             | HAS_FIELD '[' symbol ',' s_suffix ']'
   27             | HAS_FIELD '[' symbol ',' s_infix ']'
   28             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   29             | '!' qf_has_field

   30 qf_rank_sort: GREATER_BY_RANK
   31             | LESS_BY_RANK

   32 qf_bigram_sort: LESS_BY_LEFT
   33               | LESS_BY_RIGHT

   34 qf_size_sort: LESS_BY_SIZE qfb_int
   35             | GREATER_BY_SIZE qfb_int
   36             | IS_SIZE '[' int_str ']'

   37 qf_date_sort: LESS_BY_DATE qfb_date
   38             | GREATER_BY_DATE qfb_date
   39             | IS_DATE '[' date ']'

   40 qf_random_sort: RANDOM
   41               | RANDOM '[' ']'
   42               | RANDOM '[' int_str ']'

   43 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   44             | GREATER_BY '[' symbol qfb_bibl ']'

   45 qfb_int: /* empty */
   46        | '[' ']'
   47        | '[' int_str ']'
   48        | '[' int_str ',' ']'
   49        | '[' int_str ',' int_str ']'
   50        | '[' ',' int_str ']'

   51 qfb_date: /* empty */
   52         | '[' ']'
   53         | '[' date ']'
   54         | '[' date ',' ']'
   55         | '[' date ',' date ']'
   56         | '[' ',' date ']'

   57 qfb_bibl: /* empty */
   58         | ','
   59         | ',' ','
   60         | ',' symbol
   61         | ',' symbol ','
   62         | ',' ',' symbol
   63         | ',' symbol ',' symbol

   64 q_clause: qc_basic
   65         | q_clause OP_AND q_clause
   66         | q_clause OP_OR q_clause
   67         | '!' q_clause
   68         | '(' q_clause ')'

   69 qc_basic: qc_tokens
   70         | qc_near

   71 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   72        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   73        | '(' qc_near ')'

   74 qc_tokens: qc_word
   75          | qc_sequence

   76 qc_sequence: '"' l_seq '"'
   77            | '(' qc_sequence ')'

   78 qc_word: qw_bareword
   79        | qw_exact
   80        | qw_regex
   81        | qw_any
   82        | qw_set_infl
   83        | qw_set_exact
   84        | qw_infix
   85        | qw_infix_set
   86        | qw_prefix
   87        | qw_prefix_set
   88        | qw_suffix
   89        | qw_suffix_set
   90        | qw_thesaurus
   91        | qw_morph
   92        | qw_lemma
   93        | qw_chunk
   94        | qw_listfile
   95        | qw_with
   96        | '(' qc_word ')'

   97 qw_bareword: s_word l_txchain
   98            | s_index '=' s_word l_txchain

   99 qw_exact: '@' s_word
  100         | s_index '=' '@' s_word

  101 qw_regex: regex
  102         | s_index '=' regex
  103         | neg_regex
  104         | s_index '=' neg_regex

  105 qw_any: '*'
  106       | s_index '=' '*'

  107 qw_set_exact: AT_LBRACE l_set '}'
  108             | s_index '=' AT_LBRACE l_set '}'

  109 qw_set_infl: '{' l_set '}' l_txchain
  110            | s_index '=' '{' l_set '}' l_txchain

  111 qw_prefix: s_prefix
  112          | s_index '=' s_prefix

  113 qw_suffix: s_suffix
  114          | s_index '=' s_suffix

  115 qw_infix: s_infix
  116         | s_index '=' s_infix

  117 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  118             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  119 qw_prefix_set: '{' l_set RBRACE_STAR
  120              | s_index '=' '{' l_set RBRACE_STAR

  121 qw_suffix_set: STAR_LBRACE l_set '}'
  122              | s_index '=' STAR_LBRACE l_set '}'

  123 qw_thesaurus: COLON_LBRACE s_semclass '}'
  124             | s_index '=' ':' '{' s_semclass '}'

  125 qw_morph: '[' l_morph ']'
  126         | s_index '=' '[' l_morph ']'

  127 qw_lemma: '%' s_lemma
  128         | s_index '=' '%' s_lemma

  129 qw_chunk: '^' s_chunk
  130         | s_index '=' '^' s_chunk

  131 qw_listfile: '<' s_filename
  132            | s_index '=' '<' s_filename

  133 qw_with: qc_word WITH qc_word

  134 l_set: /* empty */
  135      | l_set s_word
  136      | l_set ','

  137 l_morph: /* empty */
  138        | l_morph s_morphitem
  139        | l_morph ','
  140        | l_morph ';'

  141 l_seq: qc_word
  142      | l_seq qc_word
  143      | l_seq '#' integer qc_word

  144 l_txchain: /* empty */
  145          | l_txchain s_expander

  146 s_index: '$'
  147        | '$' symbol

  148 s_word: symbol

  149 s_semclass: symbol

  150 s_lemma: symbol

  151 s_chunk: symbol

  152 s_filename: symbol

  153 s_morphitem: symbol

  154 s_subcorpus: symbol

  155 symbol: SYMBOL
  156       | INTEGER
  157       | DATE

  158 s_prefix: PREFIX

  159 s_suffix: SUFFIX

  160 s_infix: INFIX

  161 s_expander: EXPANDER

  162 regex: REGEX
  163      | REGEX REGOPT

  164 neg_regex: NEG_REGEX
  165          | NEG_REGEX REGOPT

  166 int_str: INTEGER

  167 integer: int_str

  168 date: DATE
  169     | INTEGER


