Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions ')' count_filters

    4 count_filters: /* empty */
    5              | count_filters count_filter

    6 count_filter: count_by
    7             | count_sample
    8             | count_sort

    9 count_by: BY l_countkeys
   10         | BY '[' l_countkeys ']'

   11 count_sample: SAMPLE integer
   12             | SAMPLE '[' integer ']'

   13 count_sort: count_sort_op count_sort_limits

   14 count_sort_op: LESS_BY_KEY
   15              | GREATER_BY_KEY
   16              | LESS_BY_COUNT
   17              | GREATER_BY_COUNT

   18 count_sort_limits: /* empty */
   19                  | '[' ']'
   20                  | '[' symbol ']'
   21                  | '[' symbol ',' ']'
   22                  | '[' ',' symbol ']'
   23                  | '[' symbol ',' symbol ']'

   24 query_conditions: q_clause q_filters

   25 q_filters: /* empty */
   26          | q_filters q_flag
   27          | q_filters q_filter

   28 q_flag: ':' qf_subcorpora
   29       | CNTXT integer
   30       | WITHIN s_breakname
   31       | SEPARATE_HITS
   32       | NOSEPARATE_HITS
   33       | FILENAMES_ONLY
   34       | '!' FILENAMES_ONLY
   35       | DEBUG_RANK
   36       | '!' DEBUG_RANK

   37 qf_subcorpora: /* empty */
   38              | s_subcorpus
   39              | qf_subcorpora ',' s_subcorpus

   40 q_filter: qf_has_field
   41         | qf_rank_sort
   42         | qf_context_sort
   43         | qf_size_sort
   44         | qf_date_sort
   45         | qf_bibl_sort
   46         | qf_random_sort

   47 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   48             | HAS_FIELD '[' s_biblname ',' regex ']'
   49             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   50             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   51             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   52             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   53             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   54             | '!' qf_has_field

   55 qf_rank_sort: GREATER_BY_RANK
   56             | LESS_BY_RANK

   57 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   58                | GREATER_BY_LEFT qfb_ctxsort
   59                | LESS_BY_RIGHT qfb_ctxsort
   60                | GREATER_BY_RIGHT qfb_ctxsort
   61                | LESS_BY_MIDDLE qfb_ctxsort
   62                | GREATER_BY_MIDDLE qfb_ctxsort

   63 qf_size_sort: LESS_BY_SIZE qfb_int
   64             | GREATER_BY_SIZE qfb_int
   65             | IS_SIZE '[' int_str ']'

   66 qf_date_sort: LESS_BY_DATE qfb_date
   67             | GREATER_BY_DATE qfb_date
   68             | IS_DATE '[' date ']'

   69 qf_random_sort: RANDOM
   70               | RANDOM '[' ']'
   71               | RANDOM '[' int_str ']'

   72 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   73             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   74             | LESS_BY '[' s_biblname qfb_bibl ']'
   75             | GREATER_BY '[' s_biblname qfb_bibl ']'

   76 qfb_int: /* empty */
   77        | '[' ']'
   78        | '[' int_str ']'
   79        | '[' int_str ',' ']'
   80        | '[' int_str ',' int_str ']'
   81        | '[' ',' int_str ']'

   82 qfb_date: /* empty */
   83         | '[' ']'
   84         | '[' date ']'
   85         | '[' date ',' ']'
   86         | '[' date ',' date ']'
   87         | '[' ',' date ']'

   88 qfb_bibl: /* empty */
   89         | qfb_bibl_ne

   90 qfb_bibl_ne: ','
   91            | ',' ','
   92            | ',' symbol
   93            | ',' symbol ','
   94            | ',' ',' symbol
   95            | ',' symbol ',' symbol

   96 qfb_ctxsort: /* empty */
   97            | '[' qfb_ctxkey ']'
   98            | '[' qfb_ctxkey qfb_bibl_ne ']'

   99 qfb_ctxkey: sym_str qfbc_matchref qfbc_offset
  100           | qfbc_matchref qfbc_offset

  101 qfbc_matchref: /* empty */
  102              | matchid

  103 qfbc_offset: /* empty */
  104            | integer
  105            | '+' integer
  106            | '-' integer

  107 q_clause: qc_basic
  108         | qc_boolean
  109         | qc_concat
  110         | qc_matchid

  111 qc_matchid: q_clause matchid
  112           | '(' qc_matchid ')'

  113 qc_boolean: q_clause OP_BOOL_AND q_clause
  114           | q_clause OP_BOOL_OR q_clause
  115           | '!' q_clause
  116           | '(' qc_boolean ')'

  117 qc_concat: qc_basic qc_basic
  118          | qc_concat qc_basic
  119          | '(' qc_concat ')'

  120 qc_basic: qc_tokens
  121         | qc_near

  122 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  123        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  124        | qc_near matchid
  125        | '(' qc_near ')'

  126 qc_tokens: qc_word
  127          | qc_phrase
  128          | qc_tokens matchid

  129 qc_phrase: '"' l_phrase '"'
  130          | '(' qc_phrase ')'

  131 qc_word: qw_bareword
  132        | qw_exact
  133        | qw_regex
  134        | qw_any
  135        | qw_set_infl
  136        | qw_set_exact
  137        | qw_infix
  138        | qw_infix_set
  139        | qw_prefix
  140        | qw_prefix_set
  141        | qw_suffix
  142        | qw_suffix_set
  143        | qw_thesaurus
  144        | qw_morph
  145        | qw_lemma
  146        | qw_chunk
  147        | qw_anchor
  148        | qw_listfile
  149        | qw_with
  150        | qw_without
  151        | qw_matchid
  152        | '(' qc_word ')'

  153 qw_bareword: s_word l_txchain
  154            | s_index '=' s_word l_txchain

  155 qw_exact: '@' s_word
  156         | s_index '=' '@' s_word

  157 qw_regex: regex
  158         | s_index '=' regex
  159         | neg_regex
  160         | s_index '=' neg_regex

  161 qw_any: '*'
  162       | s_index '=' '*'

  163 qw_set_exact: AT_LBRACE l_set '}'
  164             | s_index '=' AT_LBRACE l_set '}'

  165 qw_set_infl: '{' l_set '}' l_txchain
  166            | s_index '=' '{' l_set '}' l_txchain

  167 qw_prefix: s_prefix
  168          | s_index '=' s_prefix

  169 qw_suffix: s_suffix
  170          | s_index '=' s_suffix

  171 qw_infix: s_infix
  172         | s_index '=' s_infix

  173 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  174             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  175 qw_prefix_set: '{' l_set RBRACE_STAR
  176              | s_index '=' '{' l_set RBRACE_STAR

  177 qw_suffix_set: STAR_LBRACE l_set '}'
  178              | s_index '=' STAR_LBRACE l_set '}'

  179 qw_thesaurus: COLON_LBRACE s_semclass '}'
  180             | s_index '=' ':' '{' s_semclass '}'

  181 qw_morph: '[' l_morph ']'
  182         | s_index '=' '[' l_morph ']'

  183 qw_lemma: '%' s_lemma
  184         | s_index '=' '%' s_lemma

  185 qw_chunk: '^' s_chunk
  186         | s_index '=' '^' s_chunk

  187 qw_anchor: DOLLAR_DOT '=' int_str
  188          | DOLLAR_DOT symbol '=' int_str

  189 qw_listfile: '<' s_filename
  190            | s_index '=' '<' s_filename

  191 qw_with: qc_word WITH qc_word

  192 qw_without: qc_word WITHOUT qc_word

  193 qw_matchid: qc_word matchid

  194 l_set: /* empty */
  195      | l_set s_word
  196      | l_set ','

  197 l_morph: /* empty */
  198        | l_morph s_morphitem
  199        | l_morph ','
  200        | l_morph ';'

  201 l_phrase: qc_word
  202         | l_phrase qc_word
  203         | l_phrase '#' integer qc_word
  204         | l_phrase HASH_LESS integer qc_word
  205         | l_phrase HASH_GREATER integer qc_word
  206         | l_phrase HASH_EQUAL integer qc_word

  207 l_txchain: /* empty */
  208          | l_txchain s_expander

  209 l_countkeys: /* empty */
  210            | count_key
  211            | l_countkeys ',' count_key

  212 count_key: '*'
  213          | '@' symbol
  214          | KW_FILEID
  215          | KW_FILENAME
  216          | KW_DATE
  217          | KW_DATE '/' integer
  218          | s_biblname
  219          | ck_index ck_matchid ck_offset
  220          | count_key '~' replace_regex
  221          | '(' count_key ')'

  222 ck_index: '$' symbol

  223 ck_matchid: /* empty */
  224           | matchid

  225 ck_offset: /* empty */
  226          | integer
  227          | '+' integer
  228          | '-' integer

  229 s_index: '$'
  230        | '$' symbol

  231 s_word: symbol

  232 s_semclass: symbol

  233 s_lemma: symbol

  234 s_chunk: symbol

  235 s_filename: symbol

  236 s_morphitem: symbol

  237 s_subcorpus: symbol

  238 s_biblname: symbol

  239 s_breakname: symbol
  240            | KW_FILENAME

  241 symbol: SYMBOL
  242       | INTEGER
  243       | DATE

  244 sym_str: SYMBOL

  245 s_prefix: PREFIX

  246 s_suffix: SUFFIX

  247 s_infix: INFIX

  248 s_expander: EXPANDER

  249 regex: REGEX
  250      | REGEX REGOPT

  251 neg_regex: NEG_REGEX
  252          | NEG_REGEX REGOPT

  253 replace_regex: REGEX_SEARCH REGEX_REPLACE
  254              | REGEX_SEARCH REGEX_REPLACE REGOPT

  255 int_str: INTEGER

  256 integer: int_str

  257 date: DATE
  258     | INTEGER

  259 matchid: '=' integer


