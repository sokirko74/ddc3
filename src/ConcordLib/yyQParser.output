  102        | qw_thesaurus
  103        | qw_morph
  104        | qw_lemma
  105        | qw_chunk
  106        | qw_anchor
  107        | qw_listfile
  108        | qw_with
  109        | '(' qc_word ')'

  110 qw_bareword: s_word l_txchain
  111            | s_index '=' s_word l_txchain

  112 qw_exact: '@' s_word
  113         | s_index '=' '@' s_word

  114 qw_regex: regex
  115         | s_index '=' regex
  116         | neg_regex
  117         | s_index '=' neg_regex

  118 qw_any: '*'
  119       | s_index '=' '*'

  120 qw_set_exact: AT_LBRACE l_set '}'
  121             | s_index '=' AT_LBRACE l_set '}'

  122 qw_set_infl: '{' l_set '}' l_txchain
  123            | s_index '=' '{' l_set '}' l_txchain

  124 qw_prefix: s_prefix
  125          | s_index '=' s_prefix

  126 qw_suffix: s_suffix
  127          | s_index '=' s_suffix

  128 qw_infix: s_infix
  129         | s_index '=' s_infix

  130 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  131             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  132 qw_prefix_set: '{' l_set RBRACE_STAR
  133              | s_index '=' '{' l_set RBRACE_STAR

  134 qw_suffix_set: STAR_LBRACE l_set '}'
  135              | s_index '=' STAR_LBRACE l_set '}'

  136 qw_thesaurus: COLON_LBRACE s_semclass '}'
  137             | s_index '=' ':' '{' s_semclass '}'

  138 qw_morph: '[' l_morph ']'
  139         | s_index '=' '[' l_morph ']'

  140 qw_lemma: '%' s_lemma
  141         | s_index '=' '%' s_lemma

  142 qw_chunk: '^' s_chunk
  143         | s_index '=' '^' s_chunk

  144 qw_anchor: DOLLAR_DOT '=' int_str
  145          | DOLLAR_DOT symbol '=' int_str

  146 qw_listfile: '<' s_filename
  147            | s_index '=' '<' s_filename

  148 qw_with: qc_word WITH qc_word

  149 l_set: /* empty */
  150      | l_set s_word
  151      | l_set ','

  152 l_morph: /* empty */
  153        | l_morph s_morphitem
  154        | l_morph ','
  155        | l_morph ';'

  156 l_phrase: qc_word
  157         | l_phrase qc_word
  158         | l_phrase '#' integer qc_word
  159         | l_phrase HASH_LESS integer qc_word
  160         | l_phrase HASH_GREATER integer qc_word
  161         | l_phrase HASH_EQUAL integer qc_word

  162 l_txchain: /* empty */
  163          | l_txchain s_expander

  164 s_index: '$'
  165        | '$' symbol

  166 s_word: symbol

  167 s_semclass: symbol

  168 s_lemma: symbol

  169 s_chunk: symbol

  170 s_filename: symbol

  171 s_morphitem: symbol

  172 s_subcorpus: symbol

  173 symbol: SYMBOL
  174       | INTEGER
  175       | DATE

  176 sym_str: SYMBOL

  177 s_prefix: PREFIX

  178 s_suffix: SUFFIX

  179 s_infix: INFIX

  180 s_expander: EXPANDER

  181 regex: REGEX
  182      | REGEX REGOPT

  183 neg_regex: NEG_REGEX
