Grammar

    0 $accept: query $end

    1 query: q_clause q_filters

    2 q_filters: /* empty */
    3          | q_filters q_flag
    4          | q_filters q_filter

    5 q_flag: ':' qf_subcorpora
    6       | CNTXT integer
    7       | WITHIN symbol
    8       | FILENAMES_ONLY
    9       | '!' FILENAMES_ONLY
   10       | DEBUG_RANK
   11       | '!' DEBUG_RANK

   12 qf_subcorpora: /* empty */
   13              | s_subcorpus
   14              | qf_subcorpora ',' s_subcorpus

   15 q_filter: qf_has_field
   16         | qf_rank_sort
   17         | qf_context_sort
   18         | qf_size_sort
   19         | qf_date_sort
   20         | qf_bibl_sort
   21         | qf_random_sort

   22 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   23             | HAS_FIELD '[' symbol ',' regex ']'
   24             | HAS_FIELD '[' symbol ',' neg_regex ']'
   25             | HAS_FIELD '[' symbol ',' s_prefix ']'
   26             | HAS_FIELD '[' symbol ',' s_suffix ']'
   27             | HAS_FIELD '[' symbol ',' s_infix ']'
   28             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   29             | '!' qf_has_field

   30 qf_rank_sort: GREATER_BY_RANK
   31             | LESS_BY_RANK

   32 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   33                | GREATER_BY_LEFT qfb_ctxsort
   34                | LESS_BY_RIGHT qfb_ctxsort
   35                | GREATER_BY_RIGHT qfb_ctxsort
   36                | LESS_BY_CONTEXT qfb_ctxsort
   37                | GREATER_BY_CONTEXT qfb_ctxsort

   38 qf_size_sort: LESS_BY_SIZE qfb_int
   39             | GREATER_BY_SIZE qfb_int
   40             | IS_SIZE '[' int_str ']'

   41 qf_date_sort: LESS_BY_DATE qfb_date
   42             | GREATER_BY_DATE qfb_date
   43             | IS_DATE '[' date ']'

   44 qf_random_sort: RANDOM
   45               | RANDOM '[' ']'
   46               | RANDOM '[' int_str ']'

   47 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   48             | GREATER_BY '[' symbol qfb_bibl ']'

   49 qfb_int: /* empty */
   50        | '[' ']'
   51        | '[' int_str ']'
   52        | '[' int_str ',' ']'
   53        | '[' int_str ',' int_str ']'
   54        | '[' ',' int_str ']'

   55 qfb_date: /* empty */
   56         | '[' ']'
   57         | '[' date ']'
   58         | '[' date ',' ']'
   59         | '[' date ',' date ']'
   60         | '[' ',' date ']'

   61 qfb_bibl: /* empty */
   62         | ','
   63         | ',' ','
   64         | ',' symbol
   65         | ',' symbol ','
   66         | ',' ',' symbol
   67         | ',' symbol ',' symbol

   68 qfb_ctxsort: /* empty */
   69            | '[' qfb_ctxkey ']'
   70            | '[' qfb_bibl ']'
   71            | '[' qfb_ctxkey qfb_bibl ']'

   72 qfb_ctxkey: /* empty */
   73           | sym_str
   74           | integer
   75           | symbol integer

   76 q_clause: qc_basic
   77         | q_clause OP_AND q_clause
   78         | q_clause OP_OR q_clause
   79         | '!' q_clause
   80         | '(' q_clause ')'

   81 qc_basic: qc_tokens
   82         | qc_near

   83 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   84        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   85        | '(' qc_near ')'

   86 qc_tokens: qc_word
   87          | qc_phrase

   88 qc_phrase: '"' l_phrase '"'
   89          | '(' qc_phrase ')'

   90 qc_word: qw_bareword
   91        | qw_exact
   92        | qw_regex
   93        | qw_any
   94        | qw_set_infl
   95        | qw_set_exact
   96        | qw_infix
