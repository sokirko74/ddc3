State 80 conflicts: 1 shift/reduce
State 81 conflicts: 1 shift/reduce
State 82 conflicts: 1 shift/reduce


Grammar

    0 $accept: query $end

    1 query: q_clause q_filters

    2 q_filters: /* empty */
    3          | q_filters q_flag
    4          | q_filters q_filter

    5 q_flag: ':' qf_subcorpora
    6       | CNTXT integer
    7       | WITHIN symbol
    8       | FILENAMES_ONLY
    9       | '!' FILENAMES_ONLY
   10       | DEBUG_RANK
   11       | '!' DEBUG_RANK

   12 qf_subcorpora: /* empty */
   13              | s_subcorpus
   14              | qf_subcorpora ',' s_subcorpus

   15 q_filter: qf_has_field
   16         | qf_rank_sort
   17         | qf_bigram_sort
   18         | qf_size_sort
   19         | qf_date_sort
   20         | qf_bibl_sort
   21         | qf_random_sort

   22 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   23             | HAS_FIELD '[' symbol ',' regex ']'
   24             | HAS_FIELD '[' symbol ',' neg_regex ']'
   25             | HAS_FIELD '[' symbol ',' s_prefix ']'
   26             | HAS_FIELD '[' symbol ',' s_suffix ']'
   27             | HAS_FIELD '[' symbol ',' s_infix ']'
   28             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   29             | '!' qf_has_field

   30 qf_rank_sort: GREATER_BY_RANK
   31             | LESS_BY_RANK

   32 qf_bigram_sort: LESS_BY_LEFT
   33               | LESS_BY_RIGHT

   34 qf_size_sort: LESS_BY_SIZE qfb_int
   35             | GREATER_BY_SIZE qfb_int
   36             | IS_SIZE '[' int_str ']'

   37 qf_date_sort: LESS_BY_DATE qfb_date
   38             | GREATER_BY_DATE qfb_date
   39             | IS_DATE '[' date ']'

   40 qf_random_sort: RANDOM
   41               | RANDOM '[' ']'
   42               | RANDOM '[' int_str ']'

   43 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   44             | GREATER_BY '[' symbol qfb_bibl ']'

   45 qfb_int: /* empty */
   46        | '[' ']'
   47        | '[' int_str ']'
   48        | '[' int_str ',' ']'
   49        | '[' int_str ',' int_str ']'
   50        | '[' ',' int_str ']'

   51 qfb_date: /* empty */
   52         | '[' ']'
   53         | '[' date ']'
   54         | '[' date ',' ']'
   55         | '[' date ',' date ']'
   56         | '[' ',' date ']'

   57 qfb_bibl: /* empty */
   58         | ','
   59         | ',' ','
   60         | ',' symbol
   61         | ',' symbol ','
   62         | ',' ',' symbol
   63         | ',' symbol ',' symbol

   64 q_clause: qc_basic
   65         | q_clause OP_AND q_clause
   66         | q_clause OP_OR q_clause
   67         | '!' q_clause
   68         | '(' q_clause ')'

   69 qc_basic: qc_tokens
   70         | qc_near

   71 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   72        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   73        | '(' qc_near ')'

   74 qc_tokens: qc_word
   75          | qc_phrase

   76 qc_phrase: '"' l_phrase '"'
   77          | '(' qc_phrase ')'

   78 qc_word: qw_bareword
   79        | qw_exact
   80        | qw_regex
   81        | qw_any
   82        | qw_set_infl
   83        | qw_set_exact
   84        | qw_infix
   85        | qw_infix_set
   86        | qw_prefix
   87        | qw_prefix_set
   88        | qw_suffix
   89        | qw_suffix_set
   90        | qw_thesaurus
   91        | qw_morph
   92        | qw_lemma
   93        | qw_chunk
   94        | qw_anchor
   95        | qw_listfile
   96        | qw_with
   97        | '(' qc_word ')'

   98 qw_bareword: s_word l_txchain
   99            | s_index '=' s_word l_txchain

  100 qw_exact: '@' s_word
  101         | s_index '=' '@' s_word

  102 qw_regex: regex
  103         | s_index '=' regex
  104         | neg_regex
  105         | s_index '=' neg_regex

  106 qw_any: '*'
  107       | s_index '=' '*'

  108 qw_set_exact: AT_LBRACE l_set '}'
  109             | s_index '=' AT_LBRACE l_set '}'

  110 qw_set_infl: '{' l_set '}' l_txchain
  111            | s_index '=' '{' l_set '}' l_txchain

  112 qw_prefix: s_prefix
  113          | s_index '=' s_prefix

  114 qw_suffix: s_suffix
  115          | s_index '=' s_suffix

  116 qw_infix: s_infix
  117         | s_index '=' s_infix

  118 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  119             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  120 qw_prefix_set: '{' l_set RBRACE_STAR
  121              | s_index '=' '{' l_set RBRACE_STAR

  122 qw_suffix_set: STAR_LBRACE l_set '}'
  123              | s_index '=' STAR_LBRACE l_set '}'

  124 qw_thesaurus: COLON_LBRACE s_semclass '}'
  125             | s_index '=' ':' '{' s_semclass '}'

  126 qw_morph: '[' l_morph ']'
  127         | s_index '=' '[' l_morph ']'

  128 qw_lemma: '%' s_lemma
  129         | s_index '=' '%' s_lemma

  130 qw_chunk: '^' s_chunk
  131         | s_index '=' '^' s_chunk

  132 qw_anchor: DOLLAR_DOT '=' int_str
  133          | DOLLAR_DOT symbol '=' int_str

  134 qw_listfile: '<' s_filename
  135            | s_index '=' '<' s_filename

  136 qw_with: qc_word WITH qc_word

  137 l_set: /* empty */
  138      | l_set s_word
  139      | l_set ','

  140 l_morph: /* empty */
  141        | l_morph s_morphitem
  142        | l_morph ','
  143        | l_morph ';'

  144 l_phrase: qc_word
  145         | l_phrase qc_word
  146         | l_phrase '#' integer qc_word
  147         | l_phrase HASH_LESS integer qc_word
  148         | l_phrase HASH_GREATER integer qc_word
  149         | l_phrase HASH_EQUAL integer qc_word

  150 l_txchain: /* empty */
  151          | l_txchain s_expander

  152 s_index: '$'
  153        | '$' symbol

  154 s_word: symbol

  155 s_semclass: symbol

  156 s_lemma: symbol

  157 s_chunk: symbol

  158 s_filename: symbol

  159 s_morphitem: symbol

  160 s_subcorpus: symbol

  161 symbol: SYMBOL
  162       | INTEGER
  163       | DATE

  164 s_prefix: PREFIX

  165 s_suffix: SUFFIX

  166 s_infix: INFIX

  167 s_expander: EXPANDER

  168 regex: REGEX
  169      | REGEX REGOPT

  170 neg_regex: NEG_REGEX
  171          | NEG_REGEX REGOPT

  172 int_str: INTEGER

  173 integer: int_str

  174 date: DATE
  175     | INTEGER


