  216 s_infix: INFIX .

    $default  reduce using rule 216 (s_infix)


state 9

  140 qw_set_exact: AT_LBRACE . l_set '}'

    $default  reduce using rule 171 (l_set)

    l_set  go to state 68


state 10

  156 qw_thesaurus: COLON_LBRACE . s_semclass '}'

    SYMBOL   shift, and go to state 1
    INTEGER  shift, and go to state 4
    DATE     shift, and go to state 5

    s_semclass  go to state 69
    symbol      go to state 70


state 11

  150 qw_infix_set: STAR_LBRACE . l_set RBRACE_STAR
  154 qw_suffix_set: STAR_LBRACE . l_set '}'

    $default  reduce using rule 171 (l_set)

    l_set  go to state 71


state 12

  164 qw_anchor: DOLLAR_DOT . '=' int_str
