Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions ')' count_filters

    4 count_filters: /* empty */
    5              | count_filters count_filter

    6 count_filter: count_by
    7             | count_sample
    8             | count_sort

    9 count_by: BY l_countkeys
   10         | BY '[' l_countkeys ']'

   11 count_sample: SAMPLE integer
   12             | SAMPLE '[' integer ']'

   13 count_sort: LESS_BY_KEY
   14           | GREATER_BY_KEY
   15           | LESS_BY_COUNT
   16           | GREATER_BY_COUNT

   17 query_conditions: q_clause q_filters

   18 q_filters: /* empty */
   19          | q_filters q_flag
   20          | q_filters q_filter

   21 q_flag: ':' qf_subcorpora
   22       | CNTXT integer
   23       | WITHIN s_breakname
   24       | SEPARATE_HITS
   25       | NOSEPARATE_HITS
   26       | FILENAMES_ONLY
   27       | '!' FILENAMES_ONLY
   28       | DEBUG_RANK
   29       | '!' DEBUG_RANK

   30 qf_subcorpora: /* empty */
   31              | s_subcorpus
   32              | qf_subcorpora ',' s_subcorpus

   33 q_filter: qf_has_field
   34         | qf_rank_sort
   35         | qf_context_sort
   36         | qf_size_sort
   37         | qf_date_sort
   38         | qf_bibl_sort
   39         | qf_random_sort

   40 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   41             | HAS_FIELD '[' s_biblname ',' regex ']'
   42             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   43             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   44             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   45             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   46             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   47             | '!' qf_has_field

   48 qf_rank_sort: GREATER_BY_RANK
   49             | LESS_BY_RANK

   50 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   51                | GREATER_BY_LEFT qfb_ctxsort
   52                | LESS_BY_RIGHT qfb_ctxsort
   53                | GREATER_BY_RIGHT qfb_ctxsort
   54                | LESS_BY_MIDDLE qfb_ctxsort
   55                | GREATER_BY_MIDDLE qfb_ctxsort

   56 qf_size_sort: LESS_BY_SIZE qfb_int
   57             | GREATER_BY_SIZE qfb_int
   58             | IS_SIZE '[' int_str ']'

   59 qf_date_sort: LESS_BY_DATE qfb_date
   60             | GREATER_BY_DATE qfb_date
   61             | IS_DATE '[' date ']'

   62 qf_random_sort: RANDOM
   63               | RANDOM '[' ']'
   64               | RANDOM '[' int_str ']'

   65 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   66             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   67             | LESS_BY '[' s_biblname qfb_bibl ']'
   68             | GREATER_BY '[' s_biblname qfb_bibl ']'

   69 qfb_int: /* empty */
   70        | '[' ']'
   71        | '[' int_str ']'
   72        | '[' int_str ',' ']'
   73        | '[' int_str ',' int_str ']'
   74        | '[' ',' int_str ']'

   75 qfb_date: /* empty */
   76         | '[' ']'
   77         | '[' date ']'
   78         | '[' date ',' ']'
   79         | '[' date ',' date ']'
   80         | '[' ',' date ']'

   81 qfb_bibl: /* empty */
   82         | qfb_bibl_ne

   83 qfb_bibl_ne: ','
   84            | ',' ','
   85            | ',' symbol
   86            | ',' symbol ','
   87            | ',' ',' symbol
   88            | ',' symbol ',' symbol

   89 qfb_ctxsort: /* empty */
   90            | '[' qfb_ctxkey ']'
   91            | '[' qfb_ctxkey qfb_bibl_ne ']'

   92 qfb_ctxkey: sym_str qfbc_matchref qfbc_offset
   93           | qfbc_matchref qfbc_offset

   94 qfbc_matchref: /* empty */
   95              | matchid

   96 qfbc_offset: /* empty */
   97            | integer
   98            | '+' integer
   99            | '-' integer

  100 q_clause: qc_basic
  101         | qc_boolean
  102         | qc_concat
  103         | qc_matchid

  104 qc_matchid: q_clause matchid
  105           | '(' qc_matchid ')'

  106 qc_boolean: q_clause OP_BOOL_AND q_clause
  107           | q_clause OP_BOOL_OR q_clause
  108           | '!' q_clause
  109           | '(' qc_boolean ')'

  110 qc_concat: qc_basic qc_basic
  111          | qc_concat qc_basic
  112          | '(' qc_concat ')'

  113 qc_basic: qc_tokens
  114         | qc_near

  115 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  116        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  117        | qc_near matchid
  118        | '(' qc_near ')'

  119 qc_tokens: qc_word
  120          | qc_phrase
  121          | qc_tokens matchid

  122 qc_phrase: '"' l_phrase '"'
  123          | '(' qc_phrase ')'

  124 qc_word: qw_bareword
  125        | qw_exact
  126        | qw_regex
  127        | qw_any
  128        | qw_set_infl
  129        | qw_set_exact
  130        | qw_infix
  131        | qw_infix_set
  132        | qw_prefix
  133        | qw_prefix_set
  134        | qw_suffix
  135        | qw_suffix_set
  136        | qw_thesaurus
  137        | qw_morph
  138        | qw_lemma
  139        | qw_chunk
  140        | qw_anchor
  141        | qw_listfile
  142        | qw_with
  143        | qw_without
  144        | qw_matchid
  145        | '(' qc_word ')'

  146 qw_bareword: s_word l_txchain
  147            | s_index '=' s_word l_txchain

  148 qw_exact: '@' s_word
  149         | s_index '=' '@' s_word

  150 qw_regex: regex
  151         | s_index '=' regex
  152         | neg_regex
  153         | s_index '=' neg_regex

  154 qw_any: '*'
  155       | s_index '=' '*'

  156 qw_set_exact: AT_LBRACE l_set '}'
  157             | s_index '=' AT_LBRACE l_set '}'

  158 qw_set_infl: '{' l_set '}' l_txchain
  159            | s_index '=' '{' l_set '}' l_txchain

  160 qw_prefix: s_prefix
  161          | s_index '=' s_prefix

  162 qw_suffix: s_suffix
  163          | s_index '=' s_suffix

  164 qw_infix: s_infix
  165         | s_index '=' s_infix

  166 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  167             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  168 qw_prefix_set: '{' l_set RBRACE_STAR
  169              | s_index '=' '{' l_set RBRACE_STAR

  170 qw_suffix_set: STAR_LBRACE l_set '}'
  171              | s_index '=' STAR_LBRACE l_set '}'

  172 qw_thesaurus: COLON_LBRACE s_semclass '}'
  173             | s_index '=' ':' '{' s_semclass '}'

  174 qw_morph: '[' l_morph ']'
  175         | s_index '=' '[' l_morph ']'

  176 qw_lemma: '%' s_lemma
  177         | s_index '=' '%' s_lemma

  178 qw_chunk: '^' s_chunk
  179         | s_index '=' '^' s_chunk

  180 qw_anchor: DOLLAR_DOT '=' int_str
  181          | DOLLAR_DOT symbol '=' int_str

  182 qw_listfile: '<' s_filename
  183            | s_index '=' '<' s_filename

  184 qw_with: qc_word WITH qc_word

  185 qw_without: qc_word WITHOUT qc_word

  186 qw_matchid: qc_word matchid

  187 l_set: /* empty */
  188      | l_set s_word
  189      | l_set ','

  190 l_morph: /* empty */
  191        | l_morph s_morphitem
  192        | l_morph ','
  193        | l_morph ';'

  194 l_phrase: qc_word
  195         | l_phrase qc_word
  196         | l_phrase '#' integer qc_word
  197         | l_phrase HASH_LESS integer qc_word
  198         | l_phrase HASH_GREATER integer qc_word
  199         | l_phrase HASH_EQUAL integer qc_word

  200 l_txchain: /* empty */
  201          | l_txchain s_expander

  202 l_countkeys: /* empty */
  203            | count_key
  204            | l_countkeys ',' count_key

  205 count_key: '*'
  206          | '@' symbol
  207          | KW_FILEID
  208          | KW_FILENAME
  209          | KW_DATE
  210          | KW_DATE '/' integer
  211          | s_biblname
  212          | ck_index ck_matchid ck_offset
  213          | count_key '~' replace_regex
  214          | '(' count_key ')'

  215 ck_index: '$' symbol

  216 ck_matchid: /* empty */
  217           | matchid

  218 ck_offset: /* empty */
  219          | integer
  220          | '+' integer
  221          | '-' integer

  222 s_index: '$'
  223        | '$' symbol

  224 s_word: symbol

  225 s_semclass: symbol

  226 s_lemma: symbol

  227 s_chunk: symbol

  228 s_filename: symbol

  229 s_morphitem: symbol

  230 s_subcorpus: symbol

  231 s_biblname: symbol

  232 s_breakname: symbol
  233            | KW_FILENAME

  234 symbol: SYMBOL
  235       | INTEGER
  236       | DATE

  237 sym_str: SYMBOL

  238 s_prefix: PREFIX

  239 s_suffix: SUFFIX

  240 s_infix: INFIX

  241 s_expander: EXPANDER

  242 regex: REGEX
  243      | REGEX REGOPT

  244 neg_regex: NEG_REGEX
  245          | NEG_REGEX REGOPT

  246 replace_regex: REGEX_SEARCH REGEX_REPLACE
  247              | REGEX_SEARCH REGEX_REPLACE REGOPT

  248 int_str: INTEGER

  249 integer: int_str

  250 date: DATE
  251     | INTEGER

  252 matchid: '=' integer


