Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions ')' count_filters

    4 count_filters: /* empty */
    5              | count_filters count_filter

    6 count_filter: count_by
    7             | count_sample

    8 count_by: BY l_countkeys
    9         | BY '[' l_countkeys ']'

   10 count_sample: SAMPLE integer
   11             | SAMPLE '[' integer ']'

   12 query_conditions: q_clause q_filters

   13 q_filters: /* empty */
   14          | q_filters q_flag
   15          | q_filters q_filter

   16 q_flag: ':' qf_subcorpora
   17       | CNTXT integer
   18       | WITHIN s_breakname
   19       | SEPARATE_HITS
   20       | NOSEPARATE_HITS
   21       | FILENAMES_ONLY
   22       | '!' FILENAMES_ONLY
   23       | DEBUG_RANK
   24       | '!' DEBUG_RANK

   25 qf_subcorpora: /* empty */
   26              | s_subcorpus
   27              | qf_subcorpora ',' s_subcorpus

   28 q_filter: qf_has_field
   29         | qf_rank_sort
   30         | qf_context_sort
   31         | qf_size_sort
   32         | qf_date_sort
   33         | qf_bibl_sort
   34         | qf_random_sort

   35 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   36             | HAS_FIELD '[' s_biblname ',' regex ']'
   37             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   38             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   39             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   40             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   41             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   42             | '!' qf_has_field

   43 qf_rank_sort: GREATER_BY_RANK
   44             | LESS_BY_RANK

   45 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   46                | GREATER_BY_LEFT qfb_ctxsort
   47                | LESS_BY_RIGHT qfb_ctxsort
   48                | GREATER_BY_RIGHT qfb_ctxsort
   49                | LESS_BY_MIDDLE qfb_ctxsort
   50                | GREATER_BY_MIDDLE qfb_ctxsort

   51 qf_size_sort: LESS_BY_SIZE qfb_int
   52             | GREATER_BY_SIZE qfb_int
   53             | IS_SIZE '[' int_str ']'

   54 qf_date_sort: LESS_BY_DATE qfb_date
   55             | GREATER_BY_DATE qfb_date
   56             | IS_DATE '[' date ']'

   57 qf_random_sort: RANDOM
   58               | RANDOM '[' ']'
   59               | RANDOM '[' int_str ']'

   60 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   61             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   62             | LESS_BY '[' s_biblname qfb_bibl ']'
   63             | GREATER_BY '[' s_biblname qfb_bibl ']'

   64 qfb_int: /* empty */
   65        | '[' ']'
   66        | '[' int_str ']'
   67        | '[' int_str ',' ']'
   68        | '[' int_str ',' int_str ']'
   69        | '[' ',' int_str ']'

   70 qfb_date: /* empty */
   71         | '[' ']'
   72         | '[' date ']'
   73         | '[' date ',' ']'
   74         | '[' date ',' date ']'
   75         | '[' ',' date ']'

   76 qfb_bibl: /* empty */
   77         | qfb_bibl_ne

   78 qfb_bibl_ne: ','
   79            | ',' ','
   80            | ',' symbol
   81            | ',' symbol ','
   82            | ',' ',' symbol
   83            | ',' symbol ',' symbol

   84 qfb_ctxsort: /* empty */
   85            | '[' qfb_ctxkey ']'
   86            | '[' qfb_ctxkey qfb_bibl_ne ']'

   87 qfb_ctxkey: sym_str qfbc_matchref qfbc_offset
   88           | qfbc_matchref qfbc_offset

   89 qfbc_matchref: /* empty */
   90              | matchid

   91 qfbc_offset: /* empty */
   92            | integer
   93            | '+' integer
   94            | '-' integer

   95 q_clause: qc_basic
   96         | qc_boolean
   97         | qc_concat
   98         | qc_matchid

   99 qc_matchid: q_clause matchid
  100           | '(' qc_matchid ')'

  101 qc_boolean: q_clause OP_BOOL_AND q_clause
  102           | q_clause OP_BOOL_OR q_clause
  103           | '!' q_clause
  104           | '(' qc_boolean ')'

  105 qc_concat: qc_basic qc_basic
  106          | qc_concat qc_basic
  107          | '(' qc_concat ')'

  108 qc_basic: qc_tokens
  109         | qc_near

  110 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  111        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  112        | qc_near matchid
  113        | '(' qc_near ')'

  114 qc_tokens: qc_word
  115          | qc_phrase
  116          | qc_tokens matchid

  117 qc_phrase: '"' l_phrase '"'
  118          | '(' qc_phrase ')'

  119 qc_word: qw_bareword
  120        | qw_exact
  121        | qw_regex
  122        | qw_any
  123        | qw_set_infl
  124        | qw_set_exact
  125        | qw_infix
  126        | qw_infix_set
  127        | qw_prefix
  128        | qw_prefix_set
  129        | qw_suffix
  130        | qw_suffix_set
  131        | qw_thesaurus
  132        | qw_morph
  133        | qw_lemma
  134        | qw_chunk
  135        | qw_anchor
  136        | qw_listfile
  137        | qw_with
  138        | qw_without
  139        | qw_matchid
  140        | '(' qc_word ')'

  141 qw_bareword: s_word l_txchain
  142            | s_index '=' s_word l_txchain

  143 qw_exact: '@' s_word
  144         | s_index '=' '@' s_word

  145 qw_regex: regex
  146         | s_index '=' regex
  147         | neg_regex
  148         | s_index '=' neg_regex

  149 qw_any: '*'
  150       | s_index '=' '*'

  151 qw_set_exact: AT_LBRACE l_set '}'
  152             | s_index '=' AT_LBRACE l_set '}'

  153 qw_set_infl: '{' l_set '}' l_txchain
  154            | s_index '=' '{' l_set '}' l_txchain

  155 qw_prefix: s_prefix
  156          | s_index '=' s_prefix

  157 qw_suffix: s_suffix
  158          | s_index '=' s_suffix

  159 qw_infix: s_infix
  160         | s_index '=' s_infix

  161 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  162             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  163 qw_prefix_set: '{' l_set RBRACE_STAR
  164              | s_index '=' '{' l_set RBRACE_STAR

  165 qw_suffix_set: STAR_LBRACE l_set '}'
  166              | s_index '=' STAR_LBRACE l_set '}'

  167 qw_thesaurus: COLON_LBRACE s_semclass '}'
  168             | s_index '=' ':' '{' s_semclass '}'

  169 qw_morph: '[' l_morph ']'
  170         | s_index '=' '[' l_morph ']'

  171 qw_lemma: '%' s_lemma
  172         | s_index '=' '%' s_lemma

  173 qw_chunk: '^' s_chunk
  174         | s_index '=' '^' s_chunk

  175 qw_anchor: DOLLAR_DOT '=' int_str
  176          | DOLLAR_DOT symbol '=' int_str

  177 qw_listfile: '<' s_filename
  178            | s_index '=' '<' s_filename

  179 qw_with: qc_word WITH qc_word

  180 qw_without: qc_word WITHOUT qc_word

  181 qw_matchid: qc_word matchid

  182 l_set: /* empty */
  183      | l_set s_word
  184      | l_set ','

  185 l_morph: /* empty */
  186        | l_morph s_morphitem
  187        | l_morph ','
  188        | l_morph ';'

  189 l_phrase: qc_word
  190         | l_phrase qc_word
  191         | l_phrase '#' integer qc_word
  192         | l_phrase HASH_LESS integer qc_word
  193         | l_phrase HASH_GREATER integer qc_word
  194         | l_phrase HASH_EQUAL integer qc_word

  195 l_txchain: /* empty */
  196          | l_txchain s_expander

  197 l_countkeys: /* empty */
  198            | count_key
  199            | l_countkeys ',' count_key

  200 count_key: '*'
  201          | '@' symbol
  202          | KW_FILEID
  203          | KW_FILENAME
  204          | KW_DATE
  205          | KW_DATE '/' integer
  206          | s_biblname
  207          | ck_index ck_matchid ck_offset
  208          | count_key '~' replace_regex
  209          | '(' count_key ')'

  210 ck_index: '$' symbol

  211 ck_matchid: /* empty */
  212           | matchid

  213 ck_offset: /* empty */
  214          | integer
  215          | '+' integer
  216          | '-' integer

  217 s_index: '$'
  218        | '$' symbol

  219 s_word: symbol

  220 s_semclass: symbol

  221 s_lemma: symbol

  222 s_chunk: symbol

  223 s_filename: symbol

  224 s_morphitem: symbol

  225 s_subcorpus: symbol

  226 s_biblname: symbol

  227 s_breakname: symbol
  228            | KW_FILENAME

  229 symbol: SYMBOL
  230       | INTEGER
  231       | DATE

  232 sym_str: SYMBOL

  233 s_prefix: PREFIX

  234 s_suffix: SUFFIX

  235 s_infix: INFIX

  236 s_expander: EXPANDER

  237 regex: REGEX
  238      | REGEX REGOPT

  239 neg_regex: NEG_REGEX
  240          | NEG_REGEX REGOPT

  241 replace_regex: REGEX_SEARCH REGEX_REPLACE
  242              | REGEX_SEARCH REGEX_REPLACE REGOPT

  243 int_str: INTEGER

  244 integer: int_str

  245 date: DATE
  246     | INTEGER

  247 matchid: '=' integer


