Grammar

    0 $accept: query $end

    1 query: q_clause q_filters

    2 q_filters: /* empty */
    3          | q_filters q_flag
    4          | q_filters q_filter

    5 q_flag: ':' qf_subcorpora
    6       | CNTXT integer
    7       | WITHIN symbol
    8       | FILENAMES_ONLY
    9       | '!' FILENAMES_ONLY
   10       | DEBUG_RANK
   11       | '!' DEBUG_RANK

   12 qf_subcorpora: /* empty */
   13              | s_subcorpus
   14              | qf_subcorpora ',' s_subcorpus

   15 q_filter: qf_has_field
   16         | qf_rank_sort
   17         | qf_bigram_sort
   18         | qf_size_sort
   19         | qf_date_sort
   20         | qf_bibl_sort
   21         | qf_random_sort

   22 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   23             | HAS_FIELD '[' symbol ',' regex ']'
   24             | HAS_FIELD '[' symbol ',' neg_regex ']'
   25             | HAS_FIELD '[' symbol ',' s_prefix ']'
   26             | HAS_FIELD '[' symbol ',' s_suffix ']'
   27             | HAS_FIELD '[' symbol ',' s_infix ']'
   28             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   29             | '!' qf_has_field

   30 qf_rank_sort: GREATER_BY_RANK
   31             | LESS_BY_RANK

   32 qf_bigram_sort: LESS_BY_LEFT
   33               | LESS_BY_RIGHT

   34 qf_size_sort: LESS_BY_SIZE qfb_int
   35             | GREATER_BY_SIZE qfb_int
   36             | IS_SIZE '[' int_str ']'

   37 qf_date_sort: LESS_BY_DATE qfb_date
   38             | GREATER_BY_DATE qfb_date
   39             | IS_DATE '[' date ']'

   40 qf_random_sort: RANDOM
   41               | RANDOM '[' ']'
   42               | RANDOM '[' int_str ']'

   43 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   44             | GREATER_BY '[' symbol qfb_bibl ']'

   45 qfb_int: /* empty */
   46        | '[' ']'
   47        | '[' int_str ']'
   48        | '[' int_str ',' ']'
   49        | '[' int_str ',' int_str ']'
   50        | '[' ',' int_str ']'

   51 qfb_date: /* empty */
   52         | '[' ']'
   53         | '[' date ']'
   54         | '[' date ',' ']'
   55         | '[' date ',' date ']'
   56         | '[' ',' date ']'

   57 qfb_bibl: /* empty */
   58         | ','
   59         | ',' ','
   60         | ',' symbol
   61         | ',' symbol ','
   62         | ',' ',' symbol
   63         | ',' symbol ',' symbol

   64 q_clause: qc_basic
   65         | q_clause OP_AND q_clause
   66         | q_clause OP_OR q_clause
   67         | '!' q_clause
   68         | '(' q_clause ')'

   69 qc_basic: qc_tokens
   70         | qc_near

   71 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   72        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   73        | '(' qc_near ')'

   74 qc_tokens: qc_word
   75          | qc_sequence

   76 qc_sequence: '"' l_seq '"'
   77            | '(' qc_sequence ')'

   78 qc_word: qw_bareword
   79        | qw_exact
   80        | qw_regex
   81        | qw_set_infl
   82        | qw_set_exact
   83        | qw_infix
   84        | qw_infix_set
   85        | qw_prefix
   86        | qw_prefix_set
   87        | qw_suffix
   88        | qw_suffix_set
   89        | qw_thesaurus
   90        | qw_morph
   91        | qw_lemma
   92        | qw_chunk
   93        | qw_listfile
   94        | qw_with
   95        | '(' qc_word ')'

   96 qw_bareword: s_word l_txchain
   97            | s_index '=' s_word l_txchain

   98 qw_exact: '@' s_word
   99         | s_index '=' '@' s_word

  100 qw_regex: regex
  101         | s_index '=' regex
  102         | neg_regex
  103         | s_index '=' neg_regex

  104 qw_set_exact: AT_LBRACE l_set '}'
  105             | s_index '=' AT_LBRACE l_set '}'

  106 qw_set_infl: '{' l_set '}' l_txchain
  107            | s_index '=' '{' l_set '}' l_txchain

  108 qw_prefix: s_prefix
  109          | s_index '=' s_prefix

  110 qw_suffix: s_suffix
  111          | s_index '=' s_suffix

  112 qw_infix: s_infix
  113         | s_index '=' s_infix

  114 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  115             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  116 qw_prefix_set: '{' l_set RBRACE_STAR
  117              | s_index '=' '{' l_set RBRACE_STAR

  118 qw_suffix_set: STAR_LBRACE l_set '}'
  119              | s_index '=' STAR_LBRACE l_set '}'

  120 qw_thesaurus: COLON_LBRACE s_semclass '}'
  121             | s_index '=' ':' '{' s_semclass '}'

  122 qw_morph: '[' l_morph ']'
  123         | s_index '=' '[' l_morph ']'

  124 qw_lemma: '%' s_lemma
  125         | s_index '=' '%' s_lemma

  126 qw_chunk: '^' s_chunk
  127         | s_index '=' '^' s_chunk

  128 qw_listfile: '<' s_filename
  129            | s_index '=' '<' s_filename

  130 qw_with: qc_word WITH qc_word

  131 l_set: /* empty */
  132      | l_set s_word
  133      | l_set ','

  134 l_morph: /* empty */
  135        | l_morph s_morphitem
  136        | l_morph ','
  137        | l_morph ';'

  138 l_seq: qc_word
  139      | l_seq qc_word
  140      | l_seq '#' integer qc_word

  141 l_txchain: /* empty */
  142          | l_txchain s_expander

  143 s_index: '$'
  144        | '$' symbol

  145 s_word: symbol

  146 s_semclass: symbol

  147 s_lemma: symbol

  148 s_chunk: symbol

  149 s_filename: symbol

  150 s_morphitem: symbol

  151 s_subcorpus: symbol

  152 symbol: SYMBOL
  153       | INTEGER
  154       | DATE

  155 s_prefix: PREFIX

  156 s_suffix: SUFFIX

  157 s_infix: INFIX

  158 s_expander: EXPANDER

  159 regex: REGEX
  160      | REGEX REGOPT

  161 neg_regex: NEG_REGEX
  162          | NEG_REGEX REGOPT

  163 int_str: INTEGER

  164 integer: int_str

  165 date: DATE
  166     | INTEGER


