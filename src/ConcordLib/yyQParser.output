Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions count_filters ')' count_filters

    4 count_filters: %empty
    5              | count_filters count_filter

    6 count_filter: count_by
    7             | count_sample
    8             | count_limit
    9             | count_sort

   10 count_by: BY l_countkeys
   11         | BY '[' l_countkeys ']'

   12 count_sample: SAMPLE integer
   13             | SAMPLE '[' integer ']'

   14 count_limit: CLIMIT integer
   15            | CLIMIT '[' integer ']'

   16 count_sort: count_sort_op count_sort_minmax

   17 count_sort_op: LESS_BY_KEY
   18              | GREATER_BY_KEY
   19              | LESS_BY_COUNT
   20              | GREATER_BY_COUNT

   21 count_sort_minmax: %empty
   22                  | '[' ']'
   23                  | '[' ',' ']'
   24                  | '[' symbol ']'
   25                  | '[' symbol ',' ']'
   26                  | '[' ',' symbol ']'
   27                  | '[' symbol ',' symbol ']'

   28 query_conditions: q_clause q_filters

   29 q_filters: %empty
   30          | q_filters q_flag
   31          | q_filters q_comment
   32          | q_filters q_filter

   33 q_flag: ':' qf_subcorpora
   34       | CNTXT integer
   35       | CNTXT '[' integer ']'
   36       | WITHIN s_breakname
   37       | SEPARATE_HITS
   38       | NOSEPARATE_HITS
   39       | FILENAMES_ONLY
   40       | '!' FILENAMES_ONLY
   41       | DEBUG_RANK
   42       | '!' DEBUG_RANK

   43 qf_subcorpora: %empty
   44              | s_subcorpus
   45              | qf_subcorpora ',' s_subcorpus

   46 q_comment: KW_COMMENT symbol
   47          | KW_COMMENT '[' symbol ']'

   48 q_filter: qf_has_field
   49         | qf_rank_sort
   50         | qf_context_sort
   51         | qf_size_sort
   52         | qf_date_sort
   53         | qf_bibl_sort
   54         | qf_random_sort

   55 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   56             | HAS_FIELD '[' s_biblname ',' regex ']'
   57             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   58             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   59             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   60             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   61             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   62             | '!' qf_has_field

   63 qf_rank_sort: GREATER_BY_RANK
   64             | LESS_BY_RANK

   65 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   66                | GREATER_BY_LEFT qfb_ctxsort
   67                | LESS_BY_RIGHT qfb_ctxsort
   68                | GREATER_BY_RIGHT qfb_ctxsort
   69                | LESS_BY_MIDDLE qfb_ctxsort
   70                | GREATER_BY_MIDDLE qfb_ctxsort

   71 qf_size_sort: LESS_BY_SIZE qfb_int
   72             | GREATER_BY_SIZE qfb_int
   73             | IS_SIZE '[' int_str ']'

   74 qf_date_sort: LESS_BY_DATE qfb_date
   75             | GREATER_BY_DATE qfb_date
   76             | IS_DATE '[' date ']'

   77 qf_random_sort: RANDOM
   78               | RANDOM '[' ']'
   79               | RANDOM '[' int_str ']'

   80 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   81             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   82             | LESS_BY '[' s_biblname qfb_bibl ']'
   83             | GREATER_BY '[' s_biblname qfb_bibl ']'

   84 qfb_int: %empty
   85        | '[' ']'
   86        | '[' int_str ']'
   87        | '[' int_str ',' ']'
   88        | '[' int_str ',' int_str ']'
   89        | '[' ',' int_str ']'

   90 qfb_date: %empty
   91         | '[' ']'
   92         | '[' date ']'
   93         | '[' date ',' ']'
   94         | '[' date ',' date ']'
   95         | '[' ',' date ']'

   96 qfb_bibl: %empty
   97         | qfb_bibl_ne

   98 qfb_bibl_ne: ','
   99            | ',' ','
  100            | ',' symbol
  101            | ',' symbol ','
  102            | ',' ',' symbol
  103            | ',' symbol ',' symbol

  104 qfb_ctxsort: %empty
  105            | '[' qfb_ctxkey ']'
  106            | '[' qfb_ctxkey qfb_bibl_ne ']'

  107 qfb_ctxkey: sym_str qfbc_matchref qfbc_offset
  108           | qfbc_matchref qfbc_offset

  109 qfbc_matchref: %empty
  110              | matchid

  111 qfbc_offset: %empty
  112            | integer
  113            | '+' integer
  114            | '-' integer

  115 q_clause: qc_basic
  116         | qc_boolean
  117         | qc_concat
  118         | qc_matchid

  119 qc_matchid: q_clause matchid
  120           | '(' qc_matchid ')'

  121 qc_boolean: q_clause OP_BOOL_AND q_clause
  122           | q_clause OP_BOOL_OR q_clause
  123           | '!' q_clause
  124           | '(' qc_boolean ')'

  125 qc_concat: qc_basic qc_basic
  126          | qc_concat qc_basic
  127          | '(' qc_concat ')'

  128 qc_basic: qc_tokens
  129         | qc_near

  130 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  131        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  132        | qc_near matchid
  133        | '(' qc_near ')'

  134 qc_tokens: qc_word
  135          | qc_phrase
  136          | qc_tokens matchid

  137 qc_phrase: '"' l_phrase '"'
  138          | '(' qc_phrase ')'

  139 qc_word: qw_bareword
  140        | qw_exact
  141        | qw_regex
  142        | qw_any
  143        | qw_set_infl
  144        | qw_set_exact
  145        | qw_infix
  146        | qw_infix_set
  147        | qw_prefix
  148        | qw_prefix_set
  149        | qw_suffix
  150        | qw_suffix_set
  151        | qw_thesaurus
  152        | qw_morph
  153        | qw_lemma
  154        | qw_chunk
  155        | qw_anchor
  156        | qw_listfile
  157        | qw_with
  158        | qw_without
  159        | qw_withor
  160        | qw_keys
  161        | qw_matchid
  162        | '(' qc_word ')'

  163 qw_bareword: s_word l_txchain
  164            | s_index '=' s_word l_txchain

  165 qw_exact: '@' s_word
  166         | s_index '=' '@' s_word

  167 qw_regex: regex
  168         | s_index '=' regex
  169         | neg_regex
  170         | s_index '=' neg_regex

  171 qw_any: '*'
  172       | s_index '=' '*'

  173 qw_set_exact: AT_LBRACE l_set '}'
  174             | s_index '=' AT_LBRACE l_set '}'

  175 qw_set_infl: '{' l_set '}' l_txchain
  176            | s_index '=' '{' l_set '}' l_txchain

  177 qw_prefix: s_prefix
  178          | s_index '=' s_prefix

  179 qw_suffix: s_suffix
  180          | s_index '=' s_suffix

  181 qw_infix: s_infix
  182         | s_index '=' s_infix

  183 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  184             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  185 qw_prefix_set: '{' l_set RBRACE_STAR
  186              | s_index '=' '{' l_set RBRACE_STAR

  187 qw_suffix_set: STAR_LBRACE l_set '}'
  188              | s_index '=' STAR_LBRACE l_set '}'

  189 qw_thesaurus: COLON_LBRACE s_semclass '}'
  190             | s_index '=' ':' '{' s_semclass '}'

  191 qw_morph: '[' l_morph ']'
  192         | s_index '=' '[' l_morph ']'

  193 qw_lemma: '%' s_lemma
  194         | s_index '=' '%' s_lemma

  195 qw_chunk: '^' s_chunk
  196         | s_index '=' '^' s_chunk

  197 qw_anchor: DOLLAR_DOT '=' int_str
  198          | DOLLAR_DOT symbol '=' int_str

  199 qw_listfile: '<' s_filename
  200            | s_index '=' '<' s_filename

  201 qw_with: qc_word WITH qc_word

  202 qw_without: qc_word WITHOUT qc_word

  203 qw_withor: qc_word WITHOR qc_word

  204 qw_keys: KEYS '(' qwk_countsrc ')'
  205        | qwk_indextuple '=' KEYS '(' qwk_countsrc ')'

  206 qwk_indextuple: '$' '(' l_indextuple ')'

  207 qwk_countsrc: count_query
  208             | query_conditions count_filters

  209 qw_matchid: qc_word matchid

  210 l_set: %empty
  211      | l_set s_word
  212      | l_set ','

  213 l_morph: %empty
  214        | l_morph s_morphitem
  215        | l_morph ','
  216        | l_morph ';'

  217 l_phrase: qc_word
  218         | l_phrase qc_word
  219         | l_phrase '#' integer qc_word
  220         | l_phrase HASH_LESS integer qc_word
  221         | l_phrase HASH_GREATER integer qc_word
  222         | l_phrase HASH_EQUAL integer qc_word

  223 l_txchain: %empty
  224          | l_txchain s_expander

  225 l_countkeys: %empty
  226            | count_key
  227            | l_countkeys ',' count_key

  228 l_indextuple: %empty
  229             | s_indextuple_item
  230             | l_indextuple ',' s_indextuple_item

  231 count_key: '*'
  232          | '@' symbol
  233          | KW_FILEID
  234          | KW_FILENAME
  235          | KW_DATE
  236          | KW_DATE '/' integer
  237          | s_biblname
  238          | s_index ck_matchid ck_offset
  239          | count_key '~' replace_regex
  240          | '(' count_key ')'

  241 ck_matchid: %empty
  242           | matchid

  243 ck_offset: %empty
  244          | integer
  245          | '+' integer
  246          | '-' integer

  247 s_index: index

  248 s_indextuple_item: s_index
  249                  | symbol

  250 s_word: symbol

  251 s_semclass: symbol

  252 s_lemma: symbol

  253 s_chunk: symbol

  254 s_filename: symbol

  255 s_morphitem: symbol

  256 s_subcorpus: symbol

  257 s_biblname: symbol

  258 s_breakname: symbol
  259            | KW_FILENAME

  260 symbol: SYMBOL
  261       | INTEGER
  262       | DATE

  263 index: '$'
  264      | INDEX

  265 sym_str: SYMBOL

  266 s_prefix: PREFIX

  267 s_suffix: SUFFIX

  268 s_infix: INFIX

  269 s_expander: EXPANDER

  270 regex: REGEX
  271      | REGEX REGOPT

  272 neg_regex: NEG_REGEX
  273          | NEG_REGEX REGOPT

  274 replace_regex: REGEX_SEARCH REGEX_REPLACE
  275              | REGEX_SEARCH REGEX_REPLACE REGOPT

  276 int_str: INTEGER

  277 integer: int_str

  278 date: DATE
  279     | INTEGER

  280 $@1: %empty

  281 matchid: '=' $@1 integer


