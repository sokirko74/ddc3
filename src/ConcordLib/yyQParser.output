state 0

    0 $accept: . query $end

    SYMBOL        shift, and go to state 1
    REGEX         shift, and go to state 2
    NEG_REGEX     shift, and go to state 3
    INTEGER       shift, and go to state 4
    DATE          shift, and go to state 5
    PREFIX        shift, and go to state 6
    SUFFIX        shift, and go to state 7
    INFIX         shift, and go to state 8
    AT_LBRACE     shift, and go to state 9
    COLON_LBRACE  shift, and go to state 10
    STAR_LBRACE   shift, and go to state 11
    DOLLAR_DOT    shift, and go to state 12
    '!'           shift, and go to state 13
    NEAR          shift, and go to state 14
    '<'           shift, and go to state 15
    '$'           shift, and go to state 16
    '@'           shift, and go to state 17
    '^'           shift, and go to state 18
    '%'           shift, and go to state 19
    '['           shift, and go to state 20
    '{'           shift, and go to state 21
    '('           shift, and go to state 22
    '"'           shift, and go to state 23
    '*'           shift, and go to state 24

    query          go to state 25
    q_clause       go to state 26
    qc_boolean     go to state 27
    qc_basic       go to state 28
    qc_near        go to state 29
    qc_tokens      go to state 30
    qc_phrase      go to state 31
    qc_word        go to state 32
    qw_bareword    go to state 33
    qw_exact       go to state 34
    qw_regex       go to state 35
    qw_any         go to state 36
    qw_set_exact   go to state 37
    qw_set_infl    go to state 38
    qw_prefix      go to state 39
    qw_suffix      go to state 40
    qw_infix       go to state 41
    qw_infix_set   go to state 42
    qw_prefix_set  go to state 43
    qw_suffix_set  go to state 44
    qw_thesaurus   go to state 45
    qw_morph       go to state 46
    qw_lemma       go to state 47
    qw_chunk       go to state 48
    qw_anchor      go to state 49
    qw_listfile    go to state 50
    qw_with        go to state 51
    s_index        go to state 52
    s_word         go to state 53
    symbol         go to state 54
    s_prefix       go to state 55
    s_suffix       go to state 56
    s_infix        go to state 57
    regex          go to state 58
    neg_regex      go to state 59


