    qw_morph          go to state 50
    qw_lemma          go to state 51
    qw_chunk          go to state 52
    qw_anchor         go to state 53
    qw_listfile       go to state 54
    qw_with           go to state 55
    qw_without        go to state 56
    qw_matchid        go to state 57
    s_index           go to state 58
    s_word            go to state 59
