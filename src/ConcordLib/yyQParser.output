Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions ')' count_filters

    4 count_filters: /* empty */
    5              | count_filters count_filter

    6 count_filter: count_by

    7 count_by: BY l_countkeys
    8         | BY '[' l_countkeys ']'

    9 query_conditions: q_clause q_filters

   10 q_filters: /* empty */
   11          | q_filters q_flag
   12          | q_filters q_filter

   13 q_flag: ':' qf_subcorpora
   14       | CNTXT integer
   15       | WITHIN s_breakname
   16       | SEPARATE_HITS
   17       | NOSEPARATE_HITS
   18       | FILENAMES_ONLY
   19       | '!' FILENAMES_ONLY
   20       | DEBUG_RANK
   21       | '!' DEBUG_RANK

   22 qf_subcorpora: /* empty */
   23              | s_subcorpus
   24              | qf_subcorpora ',' s_subcorpus

   25 q_filter: qf_has_field
   26         | qf_rank_sort
   27         | qf_context_sort
   28         | qf_size_sort
   29         | qf_date_sort
   30         | qf_bibl_sort
   31         | qf_random_sort

   32 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   33             | HAS_FIELD '[' s_biblname ',' regex ']'
   34             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   35             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   36             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   37             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   38             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   39             | '!' qf_has_field

   40 qf_rank_sort: GREATER_BY_RANK
   41             | LESS_BY_RANK

   42 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   43                | GREATER_BY_LEFT qfb_ctxsort
   44                | LESS_BY_RIGHT qfb_ctxsort
   45                | GREATER_BY_RIGHT qfb_ctxsort
   46                | LESS_BY_MIDDLE qfb_ctxsort
   47                | GREATER_BY_MIDDLE qfb_ctxsort

   48 qf_size_sort: LESS_BY_SIZE qfb_int
   49             | GREATER_BY_SIZE qfb_int
   50             | IS_SIZE '[' int_str ']'

   51 qf_date_sort: LESS_BY_DATE qfb_date
   52             | GREATER_BY_DATE qfb_date
   53             | IS_DATE '[' date ']'

   54 qf_random_sort: RANDOM
   55               | RANDOM '[' ']'
   56               | RANDOM '[' int_str ']'

   57 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   58             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   59             | LESS_BY '[' s_biblname qfb_bibl ']'
   60             | GREATER_BY '[' s_biblname qfb_bibl ']'

   61 qfb_int: /* empty */
   62        | '[' ']'
   63        | '[' int_str ']'
   64        | '[' int_str ',' ']'
   65        | '[' int_str ',' int_str ']'
   66        | '[' ',' int_str ']'

   67 qfb_date: /* empty */
   68         | '[' ']'
   69         | '[' date ']'
   70         | '[' date ',' ']'
   71         | '[' date ',' date ']'
   72         | '[' ',' date ']'

   73 qfb_bibl: /* empty */
   74         | qfb_bibl_ne

   75 qfb_bibl_ne: ','
   76            | ',' ','
   77            | ',' symbol
   78            | ',' symbol ','
   79            | ',' ',' symbol
   80            | ',' symbol ',' symbol

   81 qfb_ctxsort: /* empty */
   82            | '[' qfb_ctxkey ']'
   83            | '[' qfb_ctxkey qfb_bibl_ne ']'

   84 qfb_ctxkey: sym_str qfbc_matchref qfbc_offset
   85           | qfbc_matchref qfbc_offset

   86 qfbc_matchref: /* empty */
   87              | matchid

   88 qfbc_offset: /* empty */
   89            | integer
   90            | '+' integer
   91            | '-' integer

   92 q_clause: qc_basic
   93         | qc_boolean
   94         | qc_concat
   95         | qc_matchid

   96 qc_matchid: q_clause matchid
   97           | '(' qc_matchid ')'

   98 qc_boolean: q_clause OP_BOOL_AND q_clause
   99           | q_clause OP_BOOL_OR q_clause
  100           | '!' q_clause
  101           | '(' qc_boolean ')'

  102 qc_concat: qc_basic qc_basic
  103          | qc_concat qc_basic
  104          | '(' qc_concat ')'

  105 qc_basic: qc_tokens
  106         | qc_near

  107 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  108        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  109        | qc_near matchid
  110        | '(' qc_near ')'

  111 qc_tokens: qc_word
  112          | qc_phrase
  113          | qc_tokens matchid

  114 qc_phrase: '"' l_phrase '"'
  115          | '(' qc_phrase ')'

  116 qc_word: qw_bareword
  117        | qw_exact
  118        | qw_regex
  119        | qw_any
  120        | qw_set_infl
  121        | qw_set_exact
  122        | qw_infix
  123        | qw_infix_set
  124        | qw_prefix
  125        | qw_prefix_set
  126        | qw_suffix
  127        | qw_suffix_set
  128        | qw_thesaurus
  129        | qw_morph
  130        | qw_lemma
  131        | qw_chunk
  132        | qw_anchor
  133        | qw_listfile
  134        | qw_with
  135        | qw_without
  136        | qw_matchid
  137        | '(' qc_word ')'

  138 qw_bareword: s_word l_txchain
  139            | s_index '=' s_word l_txchain

  140 qw_exact: '@' s_word
  141         | s_index '=' '@' s_word

  142 qw_regex: regex
  143         | s_index '=' regex
  144         | neg_regex
  145         | s_index '=' neg_regex

  146 qw_any: '*'
  147       | s_index '=' '*'

  148 qw_set_exact: AT_LBRACE l_set '}'
  149             | s_index '=' AT_LBRACE l_set '}'

  150 qw_set_infl: '{' l_set '}' l_txchain
  151            | s_index '=' '{' l_set '}' l_txchain

  152 qw_prefix: s_prefix
  153          | s_index '=' s_prefix

  154 qw_suffix: s_suffix
  155          | s_index '=' s_suffix

  156 qw_infix: s_infix
  157         | s_index '=' s_infix

  158 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  159             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  160 qw_prefix_set: '{' l_set RBRACE_STAR
  161              | s_index '=' '{' l_set RBRACE_STAR

  162 qw_suffix_set: STAR_LBRACE l_set '}'
  163              | s_index '=' STAR_LBRACE l_set '}'

  164 qw_thesaurus: COLON_LBRACE s_semclass '}'
  165             | s_index '=' ':' '{' s_semclass '}'

  166 qw_morph: '[' l_morph ']'
  167         | s_index '=' '[' l_morph ']'

  168 qw_lemma: '%' s_lemma
  169         | s_index '=' '%' s_lemma

  170 qw_chunk: '^' s_chunk
  171         | s_index '=' '^' s_chunk

  172 qw_anchor: DOLLAR_DOT '=' int_str
  173          | DOLLAR_DOT symbol '=' int_str

  174 qw_listfile: '<' s_filename
  175            | s_index '=' '<' s_filename

  176 qw_with: qc_word WITH qc_word

  177 qw_without: qc_word WITHOUT qc_word

  178 qw_matchid: qc_word matchid

  179 l_set: /* empty */
  180      | l_set s_word
  181      | l_set ','

  182 l_morph: /* empty */
  183        | l_morph s_morphitem
  184        | l_morph ','
  185        | l_morph ';'

  186 l_phrase: qc_word
  187         | l_phrase qc_word
  188         | l_phrase '#' integer qc_word
  189         | l_phrase HASH_LESS integer qc_word
  190         | l_phrase HASH_GREATER integer qc_word
  191         | l_phrase HASH_EQUAL integer qc_word

  192 l_txchain: /* empty */
  193          | l_txchain s_expander

  194 l_countkeys: /* empty */
  195            | l_countkeys ','
  196            | l_countkeys count_key

  197 count_key: '*'
  198          | '@' symbol
  199          | KW_FILEID
  200          | KW_FILENAME
  201          | KW_DATE
  202          | KW_DATE '/' integer
  203          | s_biblname
  204          | count_key '~' replace_regex
  205          | '(' count_key ')'

  206 s_index: '$'
  207        | '$' symbol

  208 s_word: symbol

  209 s_semclass: symbol

  210 s_lemma: symbol

  211 s_chunk: symbol

  212 s_filename: symbol

  213 s_morphitem: symbol

  214 s_subcorpus: symbol

  215 s_biblname: symbol

  216 s_breakname: symbol
  217            | KW_FILENAME

  218 symbol: SYMBOL
  219       | INTEGER
  220       | DATE

  221 sym_str: SYMBOL

  222 s_prefix: PREFIX

  223 s_suffix: SUFFIX

  224 s_infix: INFIX

  225 s_expander: EXPANDER

  226 regex: REGEX
  227      | REGEX REGOPT

  228 neg_regex: NEG_REGEX
  229          | NEG_REGEX REGOPT

  230 replace_regex: REGEX_SEARCH REGEX_REPLACE
  231              | REGEX_SEARCH REGEX_REPLACE REGOPT

  232 int_str: INTEGER

  233 integer: int_str

  234 date: DATE
  235     | INTEGER

  236 matchid: MATCHID


