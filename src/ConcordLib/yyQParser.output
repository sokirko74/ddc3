state 0

    0 $accept: . query $end

    SYMBOL        shift, and go to state 1
    REGEX         shift, and go to state 2
    NEG_REGEX     shift, and go to state 3
    INTEGER       shift, and go to state 4
    DATE          shift, and go to state 5
    PREFIX        shift, and go to state 6
    SUFFIX        shift, and go to state 7
    INFIX         shift, and go to state 8
    AT_LBRACE     shift, and go to state 9
    COLON_LBRACE  shift, and go to state 10
    STAR_LBRACE   shift, and go to state 11
    DOLLAR_DOT    shift, and go to state 12
    '!'           shift, and go to state 13
    COUNT         shift, and go to state 14
    NEAR          shift, and go to state 15
    '<'           shift, and go to state 16
    '$'           shift, and go to state 17
    '@'           shift, and go to state 18
    '^'           shift, and go to state 19
    '%'           shift, and go to state 20
    '('           shift, and go to state 21
    '['           shift, and go to state 22
    '{'           shift, and go to state 23
    '"'           shift, and go to state 24
    '*'           shift, and go to state 25

    query             go to state 26
    count_query       go to state 27
    query_conditions  go to state 28
    q_clause          go to state 29
    qc_matchid        go to state 30
    qc_boolean        go to state 31
    qc_concat         go to state 32
    qc_basic          go to state 33
    qc_near           go to state 34
    qc_tokens         go to state 35
    qc_phrase         go to state 36
    qc_word           go to state 37
    qw_bareword       go to state 38
    qw_exact          go to state 39
    qw_regex          go to state 40
    qw_any            go to state 41
    qw_set_exact      go to state 42
    qw_set_infl       go to state 43
    qw_prefix         go to state 44
    qw_suffix         go to state 45
    qw_infix          go to state 46
    qw_infix_set      go to state 47
    qw_prefix_set     go to state 48
    qw_suffix_set     go to state 49
    qw_thesaurus      go to state 50
    qw_morph          go to state 51
    qw_lemma          go to state 52
    qw_chunk          go to state 53
    qw_anchor         go to state 54
    qw_listfile       go to state 55
    qw_with           go to state 56
    qw_without        go to state 57
    qw_matchid        go to state 58
    s_index           go to state 59
    s_word            go to state 60
    symbol            go to state 61
    s_prefix          go to state 62
    s_suffix          go to state 63
    s_infix           go to state 64
    regex             go to state 65
    neg_regex         go to state 66


state 1

  234 symbol: SYMBOL .

    $default  reduce using rule 234 (symbol)


state 2

  242 regex: REGEX .
  243      | REGEX . REGOPT

    REGOPT  shift, and go to state 67

    $default  reduce using rule 242 (regex)


state 3

  244 neg_regex: NEG_REGEX .
  245          | NEG_REGEX . REGOPT

    REGOPT  shift, and go to state 68

    $default  reduce using rule 244 (neg_regex)


state 4

  235 symbol: INTEGER .

    $default  reduce using rule 235 (symbol)


state 5

  236 symbol: DATE .

    $default  reduce using rule 236 (symbol)


state 6

  238 s_prefix: PREFIX .

    $default  reduce using rule 238 (s_prefix)


state 7

  239 s_suffix: SUFFIX .

    $default  reduce using rule 239 (s_suffix)


state 8

  240 s_infix: INFIX .

    $default  reduce using rule 240 (s_infix)


state 9

  156 qw_set_exact: AT_LBRACE . l_set '}'

    $default  reduce using rule 187 (l_set)

    l_set  go to state 69


state 10

  172 qw_thesaurus: COLON_LBRACE . s_semclass '}'

    SYMBOL   shift, and go to state 1
    INTEGER  shift, and go to state 4
    DATE     shift, and go to state 5

    s_semclass  go to state 70
    symbol      go to state 71


state 11

