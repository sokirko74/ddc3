Grammar

    0 $accept: query $end

    1 query: q_clause q_filters

    2 q_filters: /* empty */
    3          | q_filters q_flag
    4          | q_filters q_filter

    5 q_flag: ':' qf_subcorpora
    6       | qf_separate_hits
    7       | CNTXT integer
    8       | WITHIN symbol
    9       | FILENAMES_ONLY
   10       | '!' FILENAMES_ONLY
   11       | DEBUG_RANK
   12       | '!' DEBUG_RANK

   13 qf_subcorpora: /* empty */
   14              | s_subcorpus
   15              | qf_subcorpora ',' s_subcorpus

   16 qf_separate_hits: SEPARATE_HITS
   17                 | NOSEPARATE_HITS
   18                 | '!' qf_separate_hits

   19 q_filter: qf_has_field
   20         | qf_rank_sort
   21         | qf_context_sort
   22         | qf_size_sort
   23         | qf_date_sort
   24         | qf_bibl_sort
   25         | qf_random_sort

   26 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   27             | HAS_FIELD '[' symbol ',' regex ']'
   28             | HAS_FIELD '[' symbol ',' neg_regex ']'
   29             | HAS_FIELD '[' symbol ',' s_prefix ']'
   30             | HAS_FIELD '[' symbol ',' s_suffix ']'
   31             | HAS_FIELD '[' symbol ',' s_infix ']'
   32             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   33             | '!' qf_has_field

   34 qf_rank_sort: GREATER_BY_RANK
   35             | LESS_BY_RANK

   36 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   37                | GREATER_BY_LEFT qfb_ctxsort
   38                | LESS_BY_RIGHT qfb_ctxsort
   39                | GREATER_BY_RIGHT qfb_ctxsort
   40                | LESS_BY_CONTEXT qfb_ctxsort
   41                | GREATER_BY_CONTEXT qfb_ctxsort

   42 qf_size_sort: LESS_BY_SIZE qfb_int
   43             | GREATER_BY_SIZE qfb_int
   44             | IS_SIZE '[' int_str ']'

   45 qf_date_sort: LESS_BY_DATE qfb_date
   46             | GREATER_BY_DATE qfb_date
   47             | IS_DATE '[' date ']'

   48 qf_random_sort: RANDOM
   49               | RANDOM '[' ']'
   50               | RANDOM '[' int_str ']'

   51 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   52             | GREATER_BY '[' symbol qfb_bibl ']'

   53 qfb_int: /* empty */
   54        | '[' ']'
   55        | '[' int_str ']'
   56        | '[' int_str ',' ']'
   57        | '[' int_str ',' int_str ']'
   58        | '[' ',' int_str ']'

   59 qfb_date: /* empty */
   60         | '[' ']'
   61         | '[' date ']'
   62         | '[' date ',' ']'
   63         | '[' date ',' date ']'
   64         | '[' ',' date ']'

   65 qfb_bibl: /* empty */
   66         | ','
   67         | ',' ','
   68         | ',' symbol
   69         | ',' symbol ','
   70         | ',' ',' symbol
   71         | ',' symbol ',' symbol

   72 qfb_ctxsort: '[' qfb_ctxkey ']'
   73            | '[' qfb_bibl ']'
   74            | '[' qfb_ctxkey qfb_bibl ']'

   75 qfb_ctxkey: sym_str
   76           | integer
   77           | symbol integer

   78 q_clause: qc_basic
   79         | q_clause OP_AND q_clause
   80         | q_clause OP_OR q_clause
   81         | '!' q_clause
   82         | '(' q_clause ')'

   83 qc_basic: qc_tokens
   84         | qc_near

   85 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   86        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   87        | '(' qc_near ')'

   88 qc_tokens: qc_word
   89          | qc_phrase

   90 qc_phrase: '"' l_phrase '"'
   91          | '(' qc_phrase ')'

   92 qc_word: qw_bareword
   93        | qw_exact
   94        | qw_regex
   95        | qw_any
   96        | qw_set_infl
   97        | qw_set_exact
   98        | qw_infix
   99        | qw_infix_set
  100        | qw_prefix
  101        | qw_prefix_set
  102        | qw_suffix
  103        | qw_suffix_set
  104        | qw_thesaurus
  105        | qw_morph
  106        | qw_lemma
  107        | qw_chunk
  108        | qw_anchor
  109        | qw_listfile
  110        | qw_with
  111        | '(' qc_word ')'

  112 qw_bareword: s_word l_txchain
  113            | s_index '=' s_word l_txchain

  114 qw_exact: '@' s_word
  115         | s_index '=' '@' s_word

  116 qw_regex: regex
  117         | s_index '=' regex
  118         | neg_regex
  119         | s_index '=' neg_regex

  120 qw_any: '*'
  121       | s_index '=' '*'

  122 qw_set_exact: AT_LBRACE l_set '}'
  123             | s_index '=' AT_LBRACE l_set '}'

  124 qw_set_infl: '{' l_set '}' l_txchain
  125            | s_index '=' '{' l_set '}' l_txchain

  126 qw_prefix: s_prefix
  127          | s_index '=' s_prefix

  128 qw_suffix: s_suffix
  129          | s_index '=' s_suffix

  130 qw_infix: s_infix
  131         | s_index '=' s_infix

  132 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  133             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  134 qw_prefix_set: '{' l_set RBRACE_STAR
  135              | s_index '=' '{' l_set RBRACE_STAR

  136 qw_suffix_set: STAR_LBRACE l_set '}'
  137              | s_index '=' STAR_LBRACE l_set '}'

  138 qw_thesaurus: COLON_LBRACE s_semclass '}'
  139             | s_index '=' ':' '{' s_semclass '}'

  140 qw_morph: '[' l_morph ']'
  141         | s_index '=' '[' l_morph ']'

  142 qw_lemma: '%' s_lemma
  143         | s_index '=' '%' s_lemma

  144 qw_chunk: '^' s_chunk
  145         | s_index '=' '^' s_chunk

  146 qw_anchor: DOLLAR_DOT '=' int_str
  147          | DOLLAR_DOT symbol '=' int_str

  148 qw_listfile: '<' s_filename
  149            | s_index '=' '<' s_filename

  150 qw_with: qc_word WITH qc_word

  151 l_set: /* empty */
  152      | l_set s_word
  153      | l_set ','

  154 l_morph: /* empty */
  155        | l_morph s_morphitem
  156        | l_morph ','
  157        | l_morph ';'

  158 l_phrase: qc_word
  159         | l_phrase qc_word
  160         | l_phrase '#' integer qc_word
  161         | l_phrase HASH_LESS integer qc_word
  162         | l_phrase HASH_GREATER integer qc_word
  163         | l_phrase HASH_EQUAL integer qc_word

  164 l_txchain: /* empty */
  165          | l_txchain s_expander

  166 s_index: '$'
  167        | '$' symbol

  168 s_word: symbol

  169 s_semclass: symbol

  170 s_lemma: symbol

  171 s_chunk: symbol

  172 s_filename: symbol

  173 s_morphitem: symbol

  174 s_subcorpus: symbol

  175 symbol: SYMBOL
  176       | INTEGER
  177       | DATE

  178 sym_str: SYMBOL

  179 s_prefix: PREFIX

  180 s_suffix: SUFFIX

  181 s_infix: INFIX

  182 s_expander: EXPANDER

  183 regex: REGEX
  184      | REGEX REGOPT

  185 neg_regex: NEG_REGEX
  186          | NEG_REGEX REGOPT

  187 int_str: INTEGER

  188 integer: int_str

  189 date: DATE
  190     | INTEGER


