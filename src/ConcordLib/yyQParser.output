Terminals unused in grammar

   CONCAT


Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions ')'

    4 query_conditions: q_clause q_filters

    5 q_filters: /* empty */
    6          | q_filters q_flag
    7          | q_filters q_filter

    8 q_flag: ':' qf_subcorpora
    9       | CNTXT integer
   10       | WITHIN symbol
   11       | SEPARATE_HITS
   12       | NOSEPARATE_HITS
   13       | FILENAMES_ONLY
   14       | '!' FILENAMES_ONLY
   15       | DEBUG_RANK
   16       | '!' DEBUG_RANK

   17 qf_subcorpora: /* empty */
   18              | s_subcorpus
   19              | qf_subcorpora ',' s_subcorpus

   20 q_filter: qf_has_field
   21         | qf_rank_sort
   22         | qf_context_sort
   23         | qf_size_sort
   24         | qf_date_sort
   25         | qf_bibl_sort
   26         | qf_random_sort

   27 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   28             | HAS_FIELD '[' symbol ',' regex ']'
   29             | HAS_FIELD '[' symbol ',' neg_regex ']'
   30             | HAS_FIELD '[' symbol ',' s_prefix ']'
   31             | HAS_FIELD '[' symbol ',' s_suffix ']'
   32             | HAS_FIELD '[' symbol ',' s_infix ']'
   33             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   34             | '!' qf_has_field

   35 qf_rank_sort: GREATER_BY_RANK
   36             | LESS_BY_RANK

   37 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   38                | GREATER_BY_LEFT qfb_ctxsort
   39                | LESS_BY_RIGHT qfb_ctxsort
   40                | GREATER_BY_RIGHT qfb_ctxsort
   41                | LESS_BY_MIDDLE qfb_ctxsort
   42                | GREATER_BY_MIDDLE qfb_ctxsort

   43 qf_size_sort: LESS_BY_SIZE qfb_int
   44             | GREATER_BY_SIZE qfb_int
   45             | IS_SIZE '[' int_str ']'

   46 qf_date_sort: LESS_BY_DATE qfb_date
   47             | GREATER_BY_DATE qfb_date
   48             | IS_DATE '[' date ']'

   49 qf_random_sort: RANDOM
   50               | RANDOM '[' ']'
   51               | RANDOM '[' int_str ']'

   52 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   53             | GREATER_BY '[' symbol qfb_bibl ']'

   54 qfb_int: /* empty */
   55        | '[' ']'
   56        | '[' int_str ']'
   57        | '[' int_str ',' ']'
   58        | '[' int_str ',' int_str ']'
   59        | '[' ',' int_str ']'

   60 qfb_date: /* empty */
   61         | '[' ']'
   62         | '[' date ']'
   63         | '[' date ',' ']'
   64         | '[' date ',' date ']'
   65         | '[' ',' date ']'

   66 qfb_bibl: /* empty */
   67         | qfb_bibl_ne

   68 qfb_bibl_ne: ','
   69            | ',' ','
   70            | ',' symbol
   71            | ',' symbol ','
   72            | ',' ',' symbol
   73            | ',' symbol ',' symbol

   74 qfb_ctxsort: /* empty */
   75            | '[' ']'
   76            | '[' qfb_bibl_ne ']'
   77            | '[' qfb_ctxkey ']'
   78            | '[' qfb_ctxkey qfb_bibl_ne ']'

   79 qfb_ctxkey: sym_str
   80           | integer
   81           | sym_str integer

   82 q_clause: qc_basic
   83         | qc_boolean
   84         | qc_concat

   85 qc_boolean: q_clause OP_BOOL_AND q_clause
   86           | q_clause OP_BOOL_OR q_clause
   87           | '!' q_clause
   88           | '(' qc_boolean ')'

   89 qc_concat: qc_basic qc_basic
   90          | qc_concat qc_basic
   91          | '(' qc_concat ')'

   92 qc_basic: qc_tokens
   93         | qc_near

   94 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   95        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   96        | '(' qc_near ')'

   97 qc_tokens: qc_word
   98          | qc_phrase

   99 qc_phrase: '"' l_phrase '"'
  100          | '(' qc_phrase ')'

  101 qc_word: qw_bareword
  102        | qw_exact
  103        | qw_regex
  104        | qw_any
  105        | qw_set_infl
  106        | qw_set_exact
  107        | qw_infix
  108        | qw_infix_set
  109        | qw_prefix
  110        | qw_prefix_set
  111        | qw_suffix
  112        | qw_suffix_set
  113        | qw_thesaurus
  114        | qw_morph
  115        | qw_lemma
  116        | qw_chunk
  117        | qw_anchor
  118        | qw_listfile
  119        | qw_with
  120        | '(' qc_word ')'

  121 qw_bareword: s_word l_txchain
  122            | s_index '=' s_word l_txchain

  123 qw_exact: '@' s_word
  124         | s_index '=' '@' s_word

  125 qw_regex: regex
  126         | s_index '=' regex
  127         | neg_regex
  128         | s_index '=' neg_regex

  129 qw_any: '*'
  130       | s_index '=' '*'

  131 qw_set_exact: AT_LBRACE l_set '}'
  132             | s_index '=' AT_LBRACE l_set '}'

  133 qw_set_infl: '{' l_set '}' l_txchain
  134            | s_index '=' '{' l_set '}' l_txchain

  135 qw_prefix: s_prefix
  136          | s_index '=' s_prefix

  137 qw_suffix: s_suffix
  138          | s_index '=' s_suffix

  139 qw_infix: s_infix
  140         | s_index '=' s_infix

  141 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  142             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  143 qw_prefix_set: '{' l_set RBRACE_STAR
  144              | s_index '=' '{' l_set RBRACE_STAR

  145 qw_suffix_set: STAR_LBRACE l_set '}'
  146              | s_index '=' STAR_LBRACE l_set '}'

  147 qw_thesaurus: COLON_LBRACE s_semclass '}'
  148             | s_index '=' ':' '{' s_semclass '}'

  149 qw_morph: '[' l_morph ']'
  150         | s_index '=' '[' l_morph ']'

  151 qw_lemma: '%' s_lemma
  152         | s_index '=' '%' s_lemma

  153 qw_chunk: '^' s_chunk
  154         | s_index '=' '^' s_chunk

  155 qw_anchor: DOLLAR_DOT '=' int_str
  156          | DOLLAR_DOT symbol '=' int_str

  157 qw_listfile: '<' s_filename
  158            | s_index '=' '<' s_filename

  159 qw_with: qc_word WITH qc_word

  160 l_set: /* empty */
  161      | l_set s_word
  162      | l_set ','

  163 l_morph: /* empty */
  164        | l_morph s_morphitem
  165        | l_morph ','
  166        | l_morph ';'

  167 l_phrase: qc_word
  168         | l_phrase qc_word
  169         | l_phrase '#' integer qc_word
  170         | l_phrase HASH_LESS integer qc_word
  171         | l_phrase HASH_GREATER integer qc_word
  172         | l_phrase HASH_EQUAL integer qc_word

  173 l_txchain: /* empty */
  174          | l_txchain s_expander

  175 s_index: '$'
  176        | '$' symbol

  177 s_word: symbol

  178 s_semclass: symbol

  179 s_lemma: symbol

  180 s_chunk: symbol

  181 s_filename: symbol

  182 s_morphitem: symbol

  183 s_subcorpus: symbol

  184 symbol: SYMBOL
  185       | INTEGER
  186       | DATE

  187 sym_str: SYMBOL

  188 s_prefix: PREFIX

  189 s_suffix: SUFFIX

  190 s_infix: INFIX

  191 s_expander: EXPANDER

  192 regex: REGEX
  193      | REGEX REGOPT

  194 neg_regex: NEG_REGEX
  195          | NEG_REGEX REGOPT

  196 int_str: INTEGER

  197 integer: int_str

  198 date: DATE
  199     | INTEGER


