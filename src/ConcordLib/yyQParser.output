Grammar

    0 $accept: query $end

    1 query: q_clause q_filters

    2 q_filters: /* empty */
    3          | q_filters q_flag
    4          | q_filters q_filter

    5 q_flag: ':' qf_subcorpora
    6       | CNTXT integer
    7       | WITHIN symbol
    8       | FILENAMES_ONLY
    9       | '!' FILENAMES_ONLY
   10       | DEBUG_RANK
   11       | '!' DEBUG_RANK

   12 qf_subcorpora: /* empty */
   13              | s_subcorpus
   14              | qf_subcorpora ',' s_subcorpus

   15 q_filter: qf_has_field
   16         | qf_rank_sort
   17         | qf_bigram_sort
   18         | qf_size_sort
   19         | qf_date_sort
   20         | qf_bibl_sort
   21         | qf_random_sort

   22 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   23             | HAS_FIELD '[' symbol ',' regex ']'

   24 qf_rank_sort: GREATER_BY_RANK
   25             | LESS_BY_RANK

   26 qf_bigram_sort: LESS_BY_LEFT
   27               | LESS_BY_RIGHT

   28 qf_size_sort: LESS_BY_SIZE qfb_int
   29             | GREATER_BY_SIZE qfb_int
   30             | IS_SIZE '[' int_str ']'

   31 qf_date_sort: LESS_BY_DATE qfb_date
   32             | GREATER_BY_DATE qfb_date
   33             | IS_DATE '[' date ']'

   34 qf_random_sort: RANDOM
   35               | RANDOM '[' ']'
   36               | RANDOM '[' int_str ']'

   37 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   38             | GREATER_BY '[' symbol qfb_bibl ']'

   39 qfb_int: /* empty */
   40        | '[' ']'
   41        | '[' int_str ']'
   42        | '[' int_str ',' ']'
   43        | '[' int_str ',' int_str ']'
   44        | '[' ',' int_str ']'

   45 qfb_date: /* empty */
   46         | '[' ']'
   47         | '[' date ']'
   48         | '[' date ',' ']'
   49         | '[' date ',' date ']'
   50         | '[' ',' date ']'

   51 qfb_bibl: /* empty */
   52         | ','
   53         | ',' ','
   54         | ',' symbol
   55         | ',' symbol ','
   56         | ',' ',' symbol
   57         | ',' symbol ',' symbol

   58 q_clause: qc_basic
   59         | q_clause OP_AND q_clause
   60         | q_clause OP_OR q_clause
   61         | '!' q_clause
   62         | '(' q_clause ')'

   63 qc_basic: qc_tokens
   64         | qc_near

   65 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   66        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   67        | '(' qc_near ')'

   68 qc_tokens: qc_word
   69          | qc_sequence

   70 qc_sequence: '"' l_seq '"'
   71            | '(' qc_sequence ')'

   72 qc_word: qw_bareword
   73        | qw_exact
   74        | qw_regex
   75        | qw_set_infl
   76        | qw_set_exact
   77        | qw_infix
   78        | qw_infix_set
   79        | qw_prefix
   80        | qw_prefix_set
   81        | qw_suffix
   82        | qw_suffix_set
   83        | qw_thesaurus
   84        | qw_morph
   85        | qw_lemma
   86        | qw_chunk
   87        | qw_listfile
   88        | qw_with
   89        | '(' qc_word ')'

   90 qw_bareword: s_word l_txchain
   91            | s_index '=' s_word l_txchain

   92 qw_exact: '@' s_word
   93         | s_index '=' '@' s_word

   94 qw_regex: regex
   95         | s_index '=' regex
   96         | neg_regex
   97         | s_index '=' neg_regex

   98 qw_set_exact: AT_LBRACE l_set '}'
   99             | s_index '=' AT_LBRACE l_set '}'

  100 qw_set_infl: '{' l_set '}' l_txchain
  101            | s_index '=' '{' l_set '}' l_txchain

  102 qw_prefix: s_prefix
  103          | s_index '=' s_prefix

  104 qw_suffix: s_suffix
  105          | s_index '=' s_suffix

  106 qw_infix: s_infix
  107         | s_index '=' s_infix

  108 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  109             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  110 qw_prefix_set: '{' l_set RBRACE_STAR
  111              | s_index '=' '{' l_set RBRACE_STAR

  112 qw_suffix_set: STAR_LBRACE l_set '}'
  113              | s_index '=' STAR_LBRACE l_set '}'

  114 qw_thesaurus: COLON_LBRACE s_semclass '}'
  115             | s_index '=' ':' '{' s_semclass '}'

  116 qw_morph: '[' l_morph ']'
  117         | s_index '=' '[' l_morph ']'

  118 qw_lemma: '%' s_lemma
  119         | s_index '=' '%' s_lemma

  120 qw_chunk: '^' s_chunk
  121         | s_index '=' '^' s_chunk

  122 qw_listfile: '<' s_filename
  123            | s_index '=' '<' s_filename

  124 qw_with: qc_word WITH qc_word

  125 l_set: /* empty */
  126      | l_set s_word
  127      | l_set ','

  128 l_morph: /* empty */
  129        | l_morph s_morphitem
  130        | l_morph ','
  131        | l_morph ';'

  132 l_seq: qc_word
  133      | l_seq qc_word
  134      | l_seq '#' integer qc_word

  135 l_txchain: /* empty */
  136          | l_txchain s_expander

  137 s_index: '$'
  138        | '$' symbol

  139 s_word: symbol

  140 s_semclass: symbol

  141 s_lemma: symbol

  142 s_chunk: symbol

  143 s_filename: symbol

  144 s_morphitem: symbol

  145 s_subcorpus: symbol

  146 symbol: SYMBOL
  147       | INTEGER
  148       | DATE

  149 s_prefix: PREFIX

  150 s_suffix: SUFFIX

  151 s_infix: INFIX

  152 s_expander: EXPANDER

  153 regex: REGEX
  154      | REGEX REGOPT

  155 neg_regex: NEG_REGEX
  156          | NEG_REGEX REGOPT

  157 int_str: INTEGER

  158 integer: int_str

  159 date: DATE
  160     | INTEGER


