Grammar

    0 $accept: query $end

    1 query: q_clause q_filters

    2 q_filters: /* empty */
    3          | q_filters q_flag
    4          | q_filters q_filter

    5 q_flag: ':' qf_subcorpora
    6       | CNTXT integer
    7       | WITHIN symbol
    8       | SEPARATE_HITS
    9       | NOSEPARATE_HITS
   10       | FILENAMES_ONLY
   11       | '!' FILENAMES_ONLY
   12       | DEBUG_RANK
   13       | '!' DEBUG_RANK

   14 qf_subcorpora: /* empty */
   15              | s_subcorpus
   16              | qf_subcorpora ',' s_subcorpus

   17 q_filter: qf_has_field
   18         | qf_rank_sort
   19         | qf_context_sort
   20         | qf_size_sort
   21         | qf_date_sort
   22         | qf_bibl_sort
   23         | qf_random_sort

   24 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   25             | HAS_FIELD '[' symbol ',' regex ']'
   26             | HAS_FIELD '[' symbol ',' neg_regex ']'
   27             | HAS_FIELD '[' symbol ',' s_prefix ']'
   28             | HAS_FIELD '[' symbol ',' s_suffix ']'
   29             | HAS_FIELD '[' symbol ',' s_infix ']'
   30             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   31             | '!' qf_has_field

   32 qf_rank_sort: GREATER_BY_RANK
   33             | LESS_BY_RANK

   34 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   35                | GREATER_BY_LEFT qfb_ctxsort
   36                | LESS_BY_RIGHT qfb_ctxsort
   37                | GREATER_BY_RIGHT qfb_ctxsort
   38                | LESS_BY_CONTEXT qfb_ctxsort
   39                | GREATER_BY_CONTEXT qfb_ctxsort

   40 qf_size_sort: LESS_BY_SIZE qfb_int
   41             | GREATER_BY_SIZE qfb_int
   42             | IS_SIZE '[' int_str ']'

   43 qf_date_sort: LESS_BY_DATE qfb_date
   44             | GREATER_BY_DATE qfb_date
   45             | IS_DATE '[' date ']'

   46 qf_random_sort: RANDOM
   47               | RANDOM '[' ']'
   48               | RANDOM '[' int_str ']'

   49 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   50             | GREATER_BY '[' symbol qfb_bibl ']'

   51 qfb_int: /* empty */
   52        | '[' ']'
   53        | '[' int_str ']'
   54        | '[' int_str ',' ']'
   55        | '[' int_str ',' int_str ']'
   56        | '[' ',' int_str ']'

   57 qfb_date: /* empty */
   58         | '[' ']'
   59         | '[' date ']'
   60         | '[' date ',' ']'
   61         | '[' date ',' date ']'
   62         | '[' ',' date ']'

   63 qfb_bibl: /* empty */
   64         | qfb_bibl_ne

   65 qfb_bibl_ne: ','
   66            | ',' ','
   67            | ',' symbol
   68            | ',' symbol ','
   69            | ',' ',' symbol
   70            | ',' symbol ',' symbol

   71 qfb_ctxsort: /* empty */
   72            | '[' qfb_ctxkey ']'
   73            | '[' qfb_bibl_ne ']'
   74            | '[' qfb_ctxkey qfb_bibl_ne ']'

   75 qfb_ctxkey: sym_str
   76           | integer
   77           | sym_str integer

   78 q_clause: qc_basic
   79         | qc_boolean

   80 qc_boolean: q_clause OP_AND q_clause
   81           | q_clause OP_OR q_clause
   82           | '!' q_clause
   83           | '(' qc_boolean ')'

   84 qc_basic: qc_tokens
   85         | qc_near

   86 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   87        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   88        | '(' qc_near ')'

   89 qc_tokens: qc_word
   90          | qc_phrase

   91 qc_phrase: '"' l_phrase '"'
   92          | '(' qc_phrase ')'

   93 qc_word: qw_bareword
   94        | qw_exact
   95        | qw_regex
   96        | qw_any
   97        | qw_set_infl
   98        | qw_set_exact
   99        | qw_infix
  100        | qw_infix_set
  101        | qw_prefix
  102        | qw_prefix_set
  103        | qw_suffix
  104        | qw_suffix_set
  105        | qw_thesaurus
  106        | qw_morph
  107        | qw_lemma
  108        | qw_chunk
  109        | qw_anchor
  110        | qw_listfile
  111        | qw_with
  112        | '(' qc_word ')'

  113 qw_bareword: s_word l_txchain
  114            | s_index '=' s_word l_txchain

  115 qw_exact: '@' s_word
  116         | s_index '=' '@' s_word

  117 qw_regex: regex
  118         | s_index '=' regex
  119         | neg_regex
  120         | s_index '=' neg_regex

  121 qw_any: '*'
  122       | s_index '=' '*'

  123 qw_set_exact: AT_LBRACE l_set '}'
  124             | s_index '=' AT_LBRACE l_set '}'

  125 qw_set_infl: '{' l_set '}' l_txchain
  126            | s_index '=' '{' l_set '}' l_txchain

  127 qw_prefix: s_prefix
  128          | s_index '=' s_prefix

  129 qw_suffix: s_suffix
  130          | s_index '=' s_suffix

  131 qw_infix: s_infix
  132         | s_index '=' s_infix

  133 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  134             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  135 qw_prefix_set: '{' l_set RBRACE_STAR
  136              | s_index '=' '{' l_set RBRACE_STAR

  137 qw_suffix_set: STAR_LBRACE l_set '}'
  138              | s_index '=' STAR_LBRACE l_set '}'

  139 qw_thesaurus: COLON_LBRACE s_semclass '}'
  140             | s_index '=' ':' '{' s_semclass '}'

  141 qw_morph: '[' l_morph ']'
  142         | s_index '=' '[' l_morph ']'

  143 qw_lemma: '%' s_lemma
  144         | s_index '=' '%' s_lemma

  145 qw_chunk: '^' s_chunk
  146         | s_index '=' '^' s_chunk

  147 qw_anchor: DOLLAR_DOT '=' int_str
  148          | DOLLAR_DOT symbol '=' int_str

  149 qw_listfile: '<' s_filename
  150            | s_index '=' '<' s_filename

  151 qw_with: qc_word WITH qc_word

  152 l_set: /* empty */
  153      | l_set s_word
  154      | l_set ','

  155 l_morph: /* empty */
  156        | l_morph s_morphitem
  157        | l_morph ','
  158        | l_morph ';'

  159 l_phrase: qc_word
  160         | l_phrase qc_word
  161         | l_phrase '#' integer qc_word
  162         | l_phrase HASH_LESS integer qc_word
  163         | l_phrase HASH_GREATER integer qc_word
  164         | l_phrase HASH_EQUAL integer qc_word

  165 l_txchain: /* empty */
  166          | l_txchain s_expander

  167 s_index: '$'
  168        | '$' symbol

  169 s_word: symbol

  170 s_semclass: symbol

  171 s_lemma: symbol

  172 s_chunk: symbol

  173 s_filename: symbol

  174 s_morphitem: symbol

  175 s_subcorpus: symbol

  176 symbol: SYMBOL
  177       | INTEGER
  178       | DATE

  179 sym_str: SYMBOL

  180 s_prefix: PREFIX

  181 s_suffix: SUFFIX

  182 s_infix: INFIX

  183 s_expander: EXPANDER

  184 regex: REGEX
  185      | REGEX REGOPT

  186 neg_regex: NEG_REGEX
  187          | NEG_REGEX REGOPT

  188 int_str: INTEGER

  189 integer: int_str

  190 date: DATE
  191     | INTEGER


