Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions count_filters ')' count_filters

    4 count_filters: /* empty */
    5              | count_filters count_filter

    6 count_filter: count_by
    7             | count_sample
    8             | count_sort
    9             | count_limit

   10 count_by: BY l_countkeys
   11         | BY '[' l_countkeys ']'

   12 count_sample: SAMPLE integer
   13             | SAMPLE '[' integer ']'

   14 count_limit: LIMIT integer
   15            | LIMIT '[' integer ']'

   16 count_sort: count_sort_op count_sort_minmax

   17 count_sort_op: LESS_BY_KEY
   18              | GREATER_BY_KEY
   19              | LESS_BY_COUNT
   20              | GREATER_BY_COUNT

   21 count_sort_minmax: /* empty */
   22                  | '[' ']'
   23                  | '[' ',' ']'
   24                  | '[' symbol ']'
   25                  | '[' symbol ',' ']'
   26                  | '[' ',' symbol ']'
   27                  | '[' symbol ',' symbol ']'

   28 query_conditions: q_clause q_filters

   29 q_filters: /* empty */
   30          | q_filters q_flag
   31          | q_filters q_filter

   32 q_flag: ':' qf_subcorpora
   33       | CNTXT integer
   34       | CNTXT '[' integer ']'
   35       | WITHIN s_breakname
   36       | SEPARATE_HITS
   37       | NOSEPARATE_HITS
   38       | FILENAMES_ONLY
   39       | '!' FILENAMES_ONLY
   40       | DEBUG_RANK
   41       | '!' DEBUG_RANK

   42 qf_subcorpora: /* empty */
   43              | s_subcorpus
   44              | qf_subcorpora ',' s_subcorpus

   45 q_filter: qf_has_field
   46         | qf_rank_sort
   47         | qf_context_sort
   48         | qf_size_sort
   49         | qf_date_sort
   50         | qf_bibl_sort
   51         | qf_random_sort

   52 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   53             | HAS_FIELD '[' s_biblname ',' regex ']'
   54             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   55             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   56             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   57             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   58             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   59             | '!' qf_has_field

   60 qf_rank_sort: GREATER_BY_RANK
   61             | LESS_BY_RANK

   62 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   63                | GREATER_BY_LEFT qfb_ctxsort
   64                | LESS_BY_RIGHT qfb_ctxsort
   65                | GREATER_BY_RIGHT qfb_ctxsort
   66                | LESS_BY_MIDDLE qfb_ctxsort
   67                | GREATER_BY_MIDDLE qfb_ctxsort

   68 qf_size_sort: LESS_BY_SIZE qfb_int
   69             | GREATER_BY_SIZE qfb_int
   70             | IS_SIZE '[' int_str ']'

   71 qf_date_sort: LESS_BY_DATE qfb_date
   72             | GREATER_BY_DATE qfb_date
   73             | IS_DATE '[' date ']'

   74 qf_random_sort: RANDOM
   75               | RANDOM '[' ']'
   76               | RANDOM '[' int_str ']'

   77 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   78             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   79             | LESS_BY '[' s_biblname qfb_bibl ']'
   80             | GREATER_BY '[' s_biblname qfb_bibl ']'

   81 qfb_int: /* empty */
   82        | '[' ']'
   83        | '[' int_str ']'
   84        | '[' int_str ',' ']'
   85        | '[' int_str ',' int_str ']'
   86        | '[' ',' int_str ']'

   87 qfb_date: /* empty */
   88         | '[' ']'
   89         | '[' date ']'
   90         | '[' date ',' ']'
   91         | '[' date ',' date ']'
   92         | '[' ',' date ']'

   93 qfb_bibl: /* empty */
   94         | qfb_bibl_ne

   95 qfb_bibl_ne: ','
   96            | ',' ','
   97            | ',' symbol
   98            | ',' symbol ','
   99            | ',' ',' symbol
  100            | ',' symbol ',' symbol

  101 qfb_ctxsort: /* empty */
  102            | '[' qfb_ctxkey ']'
  103            | '[' qfb_ctxkey qfb_bibl_ne ']'

  104 qfb_ctxkey: sym_str qfbc_matchref qfbc_offset
  105           | qfbc_matchref qfbc_offset

  106 qfbc_matchref: /* empty */
  107              | matchid

  108 qfbc_offset: /* empty */
  109            | integer
  110            | '+' integer
  111            | '-' integer

  112 q_clause: qc_basic
  113         | qc_boolean
  114         | qc_concat
  115         | qc_matchid

  116 qc_matchid: q_clause matchid
  117           | '(' qc_matchid ')'

  118 qc_boolean: q_clause OP_BOOL_AND q_clause
  119           | q_clause OP_BOOL_OR q_clause
  120           | '!' q_clause
  121           | '(' qc_boolean ')'

  122 qc_concat: qc_basic qc_basic
  123          | qc_concat qc_basic
  124          | '(' qc_concat ')'

  125 qc_basic: qc_tokens
  126         | qc_near

  127 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  128        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  129        | qc_near matchid
  130        | '(' qc_near ')'

  131 qc_tokens: qc_word
  132          | qc_phrase
  133          | qc_tokens matchid

  134 qc_phrase: '"' l_phrase '"'
  135          | '(' qc_phrase ')'

  136 qc_word: qw_bareword
  137        | qw_exact
  138        | qw_regex
  139        | qw_any
  140        | qw_set_infl
  141        | qw_set_exact
  142        | qw_infix
  143        | qw_infix_set
  144        | qw_prefix
  145        | qw_prefix_set
  146        | qw_suffix
  147        | qw_suffix_set
  148        | qw_thesaurus
  149        | qw_morph
  150        | qw_lemma
  151        | qw_chunk
  152        | qw_anchor
  153        | qw_listfile
  154        | qw_with
  155        | qw_without
  156        | qw_keys
  157        | qw_matchid
  158        | '(' qc_word ')'

  159 qw_bareword: s_word l_txchain
  160            | s_index '=' s_word l_txchain

  161 qw_exact: '@' s_word
  162         | s_index '=' '@' s_word

  163 qw_regex: regex
  164         | s_index '=' regex
  165         | neg_regex
  166         | s_index '=' neg_regex

  167 qw_any: '*'
  168       | s_index '=' '*'

  169 qw_set_exact: AT_LBRACE l_set '}'
  170             | s_index '=' AT_LBRACE l_set '}'

  171 qw_set_infl: '{' l_set '}' l_txchain
  172            | s_index '=' '{' l_set '}' l_txchain

  173 qw_prefix: s_prefix
  174          | s_index '=' s_prefix

  175 qw_suffix: s_suffix
  176          | s_index '=' s_suffix

  177 qw_infix: s_infix
  178         | s_index '=' s_infix

  179 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  180             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  181 qw_prefix_set: '{' l_set RBRACE_STAR
  182              | s_index '=' '{' l_set RBRACE_STAR

  183 qw_suffix_set: STAR_LBRACE l_set '}'
  184              | s_index '=' STAR_LBRACE l_set '}'

  185 qw_thesaurus: COLON_LBRACE s_semclass '}'
  186             | s_index '=' ':' '{' s_semclass '}'

  187 qw_morph: '[' l_morph ']'
  188         | s_index '=' '[' l_morph ']'

  189 qw_lemma: '%' s_lemma
  190         | s_index '=' '%' s_lemma

  191 qw_chunk: '^' s_chunk
  192         | s_index '=' '^' s_chunk

  193 qw_anchor: DOLLAR_DOT '=' int_str
  194          | DOLLAR_DOT symbol '=' int_str

  195 qw_listfile: '<' s_filename
  196            | s_index '=' '<' s_filename

  197 qw_with: qc_word WITH qc_word

  198 qw_without: qc_word WITHOUT qc_word

  199 qw_keys: KEYS '(' qwk_countsrc ')'
  200        | qwk_indextuple '=' KEYS '(' qwk_countsrc ')'

  201 qwk_indextuple: '$' '(' l_indextuple ')'

  202 qwk_countsrc: count_query
  203             | query_conditions count_filters

  204 qw_matchid: qc_word matchid

  205 l_set: /* empty */
  206      | l_set s_word
  207      | l_set ','

  208 l_morph: /* empty */
  209        | l_morph s_morphitem
  210        | l_morph ','
  211        | l_morph ';'

  212 l_phrase: qc_word
  213         | l_phrase qc_word
  214         | l_phrase '#' integer qc_word
  215         | l_phrase HASH_LESS integer qc_word
  216         | l_phrase HASH_GREATER integer qc_word
  217         | l_phrase HASH_EQUAL integer qc_word

  218 l_txchain: /* empty */
  219          | l_txchain s_expander

  220 l_countkeys: /* empty */
  221            | count_key
  222            | l_countkeys ',' count_key

  223 l_indextuple: /* empty */
  224             | s_index_or_symbol
  225             | l_indextuple ',' s_index_or_symbol

  226 count_key: '*'
  227          | '@' symbol
  228          | KW_FILEID
  229          | KW_FILENAME
  230          | KW_DATE
  231          | KW_DATE '/' integer
  232          | s_biblname
  233          | ck_index ck_matchid ck_offset
  234          | count_key '~' replace_regex
  235          | '(' count_key ')'

  236 ck_index: '$' symbol

  237 ck_matchid: /* empty */
  238           | matchid

  239 ck_offset: /* empty */
  240          | integer
  241          | '+' integer
  242          | '-' integer

  243 s_index: '$'
  244        | '$' symbol

  245 s_index_or_symbol: s_index
  246                  | symbol

  247 s_word: symbol

  248 s_semclass: symbol

  249 s_lemma: symbol

  250 s_chunk: symbol

  251 s_filename: symbol

  252 s_morphitem: symbol

  253 s_subcorpus: symbol

  254 s_biblname: symbol

  255 s_breakname: symbol
  256            | KW_FILENAME

  257 symbol: SYMBOL
  258       | INTEGER
  259       | DATE

  260 sym_str: SYMBOL

  261 s_prefix: PREFIX

  262 s_suffix: SUFFIX

  263 s_infix: INFIX

  264 s_expander: EXPANDER

  265 regex: REGEX
  266      | REGEX REGOPT

  267 neg_regex: NEG_REGEX
  268          | NEG_REGEX REGOPT

  269 replace_regex: REGEX_SEARCH REGEX_REPLACE
  270              | REGEX_SEARCH REGEX_REPLACE REGOPT

  271 int_str: INTEGER

  272 integer: int_str

  273 date: DATE
  274     | INTEGER

  275 matchid: '=' integer


