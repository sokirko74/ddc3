State 109 conflicts: 1 shift/reduce


Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions count_filters ')' count_filters

    4 count_filters: %empty
    5              | count_filters count_filter

    6 count_filter: count_by
    7             | count_sample
    8             | count_limit
    9             | count_sort
   10             | q_comment

   11 count_by: BY l_countkeys
   12         | BY '[' l_countkeys ']'

   13 count_sample: SAMPLE integer
   14             | SAMPLE '[' integer ']'

   15 count_limit: CLIMIT integer
   16            | CLIMIT '[' integer ']'

   17 count_sort: count_sort_op count_sort_minmax

   18 count_sort_op: LESS_BY_KEY
   19              | GREATER_BY_KEY
   20              | LESS_BY_COUNT
   21              | GREATER_BY_COUNT

   22 count_sort_minmax: %empty
   23                  | '[' ']'
   24                  | '[' ',' ']'
   25                  | '[' symbol ']'
   26                  | '[' symbol ',' ']'
   27                  | '[' ',' symbol ']'
   28                  | '[' symbol ',' symbol ']'

   29 query_conditions: q_clause q_filters

   30 q_filters: %empty
   31          | q_filters q_comment
   32          | q_filters q_flag
   33          | q_filters q_filter

   34 q_comment: KW_COMMENT symbol
   35          | KW_COMMENT '[' symbol ']'

   36 q_flag: ':' qf_subcorpora
   37       | CNTXT integer
   38       | CNTXT '[' integer ']'
   39       | WITHIN s_breakname
   40       | SEPARATE_HITS
   41       | NOSEPARATE_HITS
   42       | FILENAMES_ONLY
   43       | '!' FILENAMES_ONLY
   44       | DEBUG_RANK
   45       | '!' DEBUG_RANK

   46 qf_subcorpora: %empty
   47              | s_subcorpus
   48              | qf_subcorpora ',' s_subcorpus

   49 q_filter: qf_has_field
   50         | qf_rank_sort
   51         | qf_context_sort
   52         | qf_size_sort
   53         | qf_date_sort
   54         | qf_bibl_sort
   55         | qf_random_sort

   56 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   57             | HAS_FIELD '[' s_biblname ',' regex ']'
   58             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   59             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   60             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   61             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   62             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   63             | '!' qf_has_field

   64 qf_rank_sort: GREATER_BY_RANK
   65             | LESS_BY_RANK

   66 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   67                | GREATER_BY_LEFT qfb_ctxsort
   68                | LESS_BY_RIGHT qfb_ctxsort
   69                | GREATER_BY_RIGHT qfb_ctxsort
   70                | LESS_BY_MIDDLE qfb_ctxsort
   71                | GREATER_BY_MIDDLE qfb_ctxsort

   72 qf_size_sort: LESS_BY_SIZE qfb_int
   73             | GREATER_BY_SIZE qfb_int
   74             | IS_SIZE '[' int_str ']'

   75 qf_date_sort: LESS_BY_DATE qfb_date
   76             | GREATER_BY_DATE qfb_date
   77             | IS_DATE '[' date ']'

   78 qf_random_sort: RANDOM
   79               | RANDOM '[' ']'
   80               | RANDOM '[' int_str ']'

   81 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   82             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   83             | LESS_BY '[' s_biblname qfb_bibl ']'
   84             | GREATER_BY '[' s_biblname qfb_bibl ']'

   85 qfb_int: %empty
   86        | '[' ']'
   87        | '[' int_str ']'
   88        | '[' int_str ',' ']'
   89        | '[' int_str ',' int_str ']'
   90        | '[' ',' int_str ']'

   91 qfb_date: %empty
   92         | '[' ']'
   93         | '[' date ']'
   94         | '[' date ',' ']'
   95         | '[' date ',' date ']'
   96         | '[' ',' date ']'

   97 qfb_bibl: %empty
   98         | qfb_bibl_ne

   99 qfb_bibl_ne: ','
  100            | ',' ','
  101            | ',' symbol
  102            | ',' symbol ','
  103            | ',' ',' symbol
  104            | ',' symbol ',' symbol

  105 qfb_ctxsort: %empty
  106            | '[' qfb_ctxkey ']'
  107            | '[' qfb_ctxkey qfb_bibl_ne ']'

  108 qfb_ctxkey: sym_str qfbc_matchref qfbc_offset
  109           | qfbc_matchref qfbc_offset

  110 qfbc_matchref: %empty
  111              | matchid

  112 qfbc_offset: %empty
  113            | integer
  114            | '+' integer
  115            | '-' integer

  116 q_clause: qc_basic
  117         | qc_boolean
  118         | qc_concat
  119         | qc_matchid

  120 qc_matchid: q_clause matchid
  121           | '(' qc_matchid ')'

  122 qc_boolean: q_clause OP_BOOL_AND q_clause
  123           | q_clause OP_BOOL_OR q_clause
  124           | '!' q_clause
  125           | '(' qc_boolean ')'

  126 qc_concat: qc_basic qc_basic
  127          | qc_concat qc_basic
  128          | '(' qc_concat ')'

  129 qc_basic: qc_tokens
  130         | qc_near

  131 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  132        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  133        | qc_near matchid
  134        | '(' qc_near ')'

  135 qc_tokens: qc_word
  136          | qc_phrase
  137          | qc_tokens matchid

  138 qc_phrase: '"' l_phrase '"'
  139          | '(' qc_phrase ')'

  140 qc_word: qw_bareword
  141        | qw_exact
  142        | qw_regex
  143        | qw_any
  144        | qw_set_infl
  145        | qw_set_exact
  146        | qw_infix
  147        | qw_infix_set
  148        | qw_prefix
  149        | qw_prefix_set
  150        | qw_suffix
  151        | qw_suffix_set
  152        | qw_thesaurus
  153        | qw_morph
  154        | qw_lemma
  155        | qw_chunk
  156        | qw_anchor
  157        | qw_listfile
  158        | qw_with
  159        | qw_without
  160        | qw_withor
  161        | qw_keys
  162        | qw_matchid
  163        | '(' qc_word ')'

  164 qw_bareword: s_word l_txchain
  165            | s_index '=' s_word l_txchain

  166 qw_exact: '@' s_word
  167         | s_index '=' '@' s_word

  168 qw_regex: regex
  169         | s_index '=' regex
  170         | neg_regex
  171         | s_index '=' neg_regex

  172 qw_any: '*'
  173       | s_index '=' '*'

  174 qw_set_exact: AT_LBRACE l_set '}'
  175             | s_index '=' AT_LBRACE l_set '}'

  176 qw_set_infl: '{' l_set '}' l_txchain
  177            | s_index '=' '{' l_set '}' l_txchain

  178 qw_prefix: s_prefix
  179          | s_index '=' s_prefix

  180 qw_suffix: s_suffix
  181          | s_index '=' s_suffix

  182 qw_infix: s_infix
  183         | s_index '=' s_infix

  184 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  185             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  186 qw_prefix_set: '{' l_set RBRACE_STAR
  187              | s_index '=' '{' l_set RBRACE_STAR

  188 qw_suffix_set: STAR_LBRACE l_set '}'
  189              | s_index '=' STAR_LBRACE l_set '}'

  190 qw_thesaurus: COLON_LBRACE s_semclass '}'
  191             | s_index '=' ':' '{' s_semclass '}'

  192 qw_morph: '[' l_morph ']'
  193         | s_index '=' '[' l_morph ']'

  194 qw_lemma: '%' s_lemma
  195         | s_index '=' '%' s_lemma

  196 qw_chunk: '^' s_chunk
  197         | s_index '=' '^' s_chunk

  198 qw_anchor: DOLLAR_DOT '=' int_str
  199          | DOLLAR_DOT symbol '=' int_str

  200 qw_listfile: '<' s_filename
  201            | s_index '=' '<' s_filename

  202 qw_with: qc_word WITH qc_word

  203 qw_without: qc_word WITHOUT qc_word

  204 qw_withor: qc_word WITHOR qc_word

  205 qw_keys: KEYS '(' qwk_countsrc ')'
  206        | qwk_indextuple '=' KEYS '(' qwk_countsrc ')'

  207 qwk_indextuple: '$' '(' l_indextuple ')'

  208 qwk_countsrc: count_query
  209             | query_conditions count_filters

  210 qw_matchid: qc_word matchid

  211 l_set: %empty
  212      | l_set s_word
  213      | l_set ','

  214 l_morph: %empty
  215        | l_morph s_morphitem
  216        | l_morph ','
  217        | l_morph ';'

  218 l_phrase: qc_word
  219         | l_phrase qc_word
  220         | l_phrase '#' integer qc_word
  221         | l_phrase HASH_LESS integer qc_word
  222         | l_phrase HASH_GREATER integer qc_word
  223         | l_phrase HASH_EQUAL integer qc_word

  224 l_txchain: %empty
  225          | l_txchain s_expander

  226 l_countkeys: %empty
  227            | count_key
  228            | l_countkeys ',' count_key

  229 l_indextuple: %empty
  230             | s_indextuple_item
  231             | l_indextuple ',' s_indextuple_item

  232 count_key: '*'
  233          | '@' symbol
  234          | KW_FILEID
  235          | KW_FILENAME
  236          | KW_DATE
  237          | KW_DATE '/' integer
  238          | s_biblname
  239          | s_index ck_matchid ck_offset
  240          | count_key '~' replace_regex
  241          | '(' count_key ')'

  242 ck_matchid: %empty
  243           | matchid

  244 ck_offset: %empty
  245          | integer
  246          | '+' integer
  247          | '-' integer

  248 s_index: index

  249 s_indextuple_item: s_index
  250                  | symbol

  251 s_word: symbol

  252 s_semclass: symbol

  253 s_lemma: symbol

  254 s_chunk: symbol

  255 s_filename: symbol

  256 s_morphitem: symbol

  257 s_subcorpus: symbol

  258 s_biblname: symbol

  259 s_breakname: symbol
  260            | KW_FILENAME

  261 symbol: SYMBOL
  262       | INTEGER
  263       | DATE

  264 index: '$'
  265      | INDEX

  266 sym_str: SYMBOL

  267 s_prefix: PREFIX

  268 s_suffix: SUFFIX

  269 s_infix: INFIX

  270 s_expander: EXPANDER

  271 regex: REGEX
  272      | REGEX REGOPT

  273 neg_regex: NEG_REGEX
  274          | NEG_REGEX REGOPT

  275 replace_regex: REGEX_SEARCH REGEX_REPLACE
  276              | REGEX_SEARCH REGEX_REPLACE REGOPT

  277 int_str: INTEGER

  278 integer: int_str

  279 date: DATE
