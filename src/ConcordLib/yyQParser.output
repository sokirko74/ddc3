Terminals unused in grammar

   CONCAT
   COUNT


Grammar

    0 $accept: query $end

    1 query: query_conditions

    2 query_conditions: q_clause q_filters

    3 q_filters: /* empty */
    4          | q_filters q_flag
    5          | q_filters q_filter

    6 q_flag: ':' qf_subcorpora
    7       | CNTXT integer
    8       | WITHIN symbol
    9       | SEPARATE_HITS
   10       | NOSEPARATE_HITS
   11       | FILENAMES_ONLY
   12       | '!' FILENAMES_ONLY
   13       | DEBUG_RANK
   14       | '!' DEBUG_RANK

   15 qf_subcorpora: /* empty */
   16              | s_subcorpus
   17              | qf_subcorpora ',' s_subcorpus

   18 q_filter: qf_has_field
   19         | qf_rank_sort
   20         | qf_context_sort
   21         | qf_size_sort
   22         | qf_date_sort
   23         | qf_bibl_sort
   24         | qf_random_sort

   25 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   26             | HAS_FIELD '[' symbol ',' regex ']'
   27             | HAS_FIELD '[' symbol ',' neg_regex ']'
   28             | HAS_FIELD '[' symbol ',' s_prefix ']'
   29             | HAS_FIELD '[' symbol ',' s_suffix ']'
   30             | HAS_FIELD '[' symbol ',' s_infix ']'
   31             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   32             | '!' qf_has_field

   33 qf_rank_sort: GREATER_BY_RANK
   34             | LESS_BY_RANK

   35 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   36                | GREATER_BY_LEFT qfb_ctxsort
   37                | LESS_BY_RIGHT qfb_ctxsort
   38                | GREATER_BY_RIGHT qfb_ctxsort
   39                | LESS_BY_MIDDLE qfb_ctxsort
   40                | GREATER_BY_MIDDLE qfb_ctxsort

   41 qf_size_sort: LESS_BY_SIZE qfb_int
   42             | GREATER_BY_SIZE qfb_int
   43             | IS_SIZE '[' int_str ']'

   44 qf_date_sort: LESS_BY_DATE qfb_date
   45             | GREATER_BY_DATE qfb_date
   46             | IS_DATE '[' date ']'

   47 qf_random_sort: RANDOM
   48               | RANDOM '[' ']'
   49               | RANDOM '[' int_str ']'

   50 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   51             | GREATER_BY '[' symbol qfb_bibl ']'

   52 qfb_int: /* empty */
   53        | '[' ']'
   54        | '[' int_str ']'
   55        | '[' int_str ',' ']'
   56        | '[' int_str ',' int_str ']'
   57        | '[' ',' int_str ']'

   58 qfb_date: /* empty */
   59         | '[' ']'
   60         | '[' date ']'
   61         | '[' date ',' ']'
   62         | '[' date ',' date ']'
   63         | '[' ',' date ']'

   64 qfb_bibl: /* empty */
   65         | qfb_bibl_ne

   66 qfb_bibl_ne: ','
   67            | ',' ','
   68            | ',' symbol
   69            | ',' symbol ','
   70            | ',' ',' symbol
   71            | ',' symbol ',' symbol

   72 qfb_ctxsort: /* empty */
   73            | '[' ']'
   74            | '[' qfb_bibl_ne ']'
   75            | '[' qfb_ctxkey ']'
   76            | '[' qfb_ctxkey qfb_bibl_ne ']'

   77 qfb_ctxkey: sym_str
   78           | integer
   79           | sym_str integer

   80 q_clause: qc_basic
   81         | qc_boolean
   82         | qc_concat

   83 qc_boolean: q_clause OP_BOOL_AND q_clause
   84           | q_clause OP_BOOL_OR q_clause
   85           | '!' q_clause
   86           | '(' qc_boolean ')'

   87 qc_concat: qc_basic qc_basic
   88          | qc_concat qc_basic
   89          | '(' qc_concat ')'

   90 qc_basic: qc_tokens
   91         | qc_near

   92 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   93        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   94        | '(' qc_near ')'

   95 qc_tokens: qc_word
   96          | qc_phrase

   97 qc_phrase: '"' l_phrase '"'
   98          | '(' qc_phrase ')'

   99 qc_word: qw_bareword
  100        | qw_exact
  101        | qw_regex
  102        | qw_any
  103        | qw_set_infl
  104        | qw_set_exact
  105        | qw_infix
  106        | qw_infix_set
  107        | qw_prefix
  108        | qw_prefix_set
  109        | qw_suffix
  110        | qw_suffix_set
  111        | qw_thesaurus
  112        | qw_morph
  113        | qw_lemma
  114        | qw_chunk
  115        | qw_anchor
  116        | qw_listfile
  117        | qw_with
  118        | '(' qc_word ')'

  119 qw_bareword: s_word l_txchain
  120            | s_index '=' s_word l_txchain

  121 qw_exact: '@' s_word
  122         | s_index '=' '@' s_word

  123 qw_regex: regex
  124         | s_index '=' regex
  125         | neg_regex
  126         | s_index '=' neg_regex

  127 qw_any: '*'
  128       | s_index '=' '*'

  129 qw_set_exact: AT_LBRACE l_set '}'
  130             | s_index '=' AT_LBRACE l_set '}'

  131 qw_set_infl: '{' l_set '}' l_txchain
  132            | s_index '=' '{' l_set '}' l_txchain

  133 qw_prefix: s_prefix
  134          | s_index '=' s_prefix

  135 qw_suffix: s_suffix
  136          | s_index '=' s_suffix

  137 qw_infix: s_infix
  138         | s_index '=' s_infix

  139 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  140             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  141 qw_prefix_set: '{' l_set RBRACE_STAR
  142              | s_index '=' '{' l_set RBRACE_STAR

  143 qw_suffix_set: STAR_LBRACE l_set '}'
  144              | s_index '=' STAR_LBRACE l_set '}'

  145 qw_thesaurus: COLON_LBRACE s_semclass '}'
  146             | s_index '=' ':' '{' s_semclass '}'

  147 qw_morph: '[' l_morph ']'
  148         | s_index '=' '[' l_morph ']'

  149 qw_lemma: '%' s_lemma
  150         | s_index '=' '%' s_lemma

  151 qw_chunk: '^' s_chunk
  152         | s_index '=' '^' s_chunk

  153 qw_anchor: DOLLAR_DOT '=' int_str
  154          | DOLLAR_DOT symbol '=' int_str

  155 qw_listfile: '<' s_filename
  156            | s_index '=' '<' s_filename

  157 qw_with: qc_word WITH qc_word

  158 l_set: /* empty */
  159      | l_set s_word
  160      | l_set ','

  161 l_morph: /* empty */
  162        | l_morph s_morphitem
  163        | l_morph ','
  164        | l_morph ';'

  165 l_phrase: qc_word
  166         | l_phrase qc_word
  167         | l_phrase '#' integer qc_word
  168         | l_phrase HASH_LESS integer qc_word
  169         | l_phrase HASH_GREATER integer qc_word
  170         | l_phrase HASH_EQUAL integer qc_word

  171 l_txchain: /* empty */
  172          | l_txchain s_expander

  173 s_index: '$'
  174        | '$' symbol

  175 s_word: symbol

  176 s_semclass: symbol

  177 s_lemma: symbol

  178 s_chunk: symbol

  179 s_filename: symbol

  180 s_morphitem: symbol

  181 s_subcorpus: symbol

  182 symbol: SYMBOL
  183       | INTEGER
  184       | DATE

  185 sym_str: SYMBOL

  186 s_prefix: PREFIX

  187 s_suffix: SUFFIX

  188 s_infix: INFIX

  189 s_expander: EXPANDER

  190 regex: REGEX
  191      | REGEX REGOPT

  192 neg_regex: NEG_REGEX
  193          | NEG_REGEX REGOPT

  194 int_str: INTEGER

  195 integer: int_str

  196 date: DATE
  197     | INTEGER


