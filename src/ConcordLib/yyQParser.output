Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions ')' count_filters

    4 count_filters: /* empty */
    5              | count_filters count_filter

    6 count_filter: count_by

    7 count_by: BY l_countkeys
    8         | BY '[' l_countkeys ']'

    9 query_conditions: q_clause q_filters

   10 q_filters: /* empty */
   11          | q_filters q_flag
   12          | q_filters q_filter

   13 q_flag: ':' qf_subcorpora
   14       | CNTXT integer
   15       | WITHIN s_breakname
   16       | SEPARATE_HITS
   17       | NOSEPARATE_HITS
   18       | FILENAMES_ONLY
   19       | '!' FILENAMES_ONLY
   20       | DEBUG_RANK
   21       | '!' DEBUG_RANK

   22 qf_subcorpora: /* empty */
   23              | s_subcorpus
   24              | qf_subcorpora ',' s_subcorpus

   25 q_filter: qf_has_field
   26         | qf_rank_sort
   27         | qf_context_sort
   28         | qf_size_sort
   29         | qf_date_sort
   30         | qf_bibl_sort
   31         | qf_random_sort

   32 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   33             | HAS_FIELD '[' s_biblname ',' regex ']'
   34             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   35             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   36             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   37             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   38             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   39             | '!' qf_has_field

   40 qf_rank_sort: GREATER_BY_RANK
   41             | LESS_BY_RANK

   42 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   43                | GREATER_BY_LEFT qfb_ctxsort
   44                | LESS_BY_RIGHT qfb_ctxsort
   45                | GREATER_BY_RIGHT qfb_ctxsort
   46                | LESS_BY_MIDDLE qfb_ctxsort
   47                | GREATER_BY_MIDDLE qfb_ctxsort

   48 qf_size_sort: LESS_BY_SIZE qfb_int
   49             | GREATER_BY_SIZE qfb_int
   50             | IS_SIZE '[' int_str ']'

   51 qf_date_sort: LESS_BY_DATE qfb_date
   52             | GREATER_BY_DATE qfb_date
   53             | IS_DATE '[' date ']'

   54 qf_random_sort: RANDOM
   55               | RANDOM '[' ']'
   56               | RANDOM '[' int_str ']'

   57 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   58             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   59             | LESS_BY '[' s_biblname qfb_bibl ']'
   60             | GREATER_BY '[' s_biblname qfb_bibl ']'

   61 qfb_int: /* empty */
   62        | '[' ']'
   63        | '[' int_str ']'
   64        | '[' int_str ',' ']'
   65        | '[' int_str ',' int_str ']'
   66        | '[' ',' int_str ']'

   67 qfb_date: /* empty */
   68         | '[' ']'
   69         | '[' date ']'
   70         | '[' date ',' ']'
   71         | '[' date ',' date ']'
   72         | '[' ',' date ']'

   73 qfb_bibl: /* empty */
   74         | qfb_bibl_ne

   75 qfb_bibl_ne: ','
   76            | ',' ','
   77            | ',' symbol
   78            | ',' symbol ','
   79            | ',' ',' symbol
   80            | ',' symbol ',' symbol

   81 qfb_ctxsort: /* empty */
   82            | '[' qfb_ctxkey ']'
   83            | '[' qfb_ctxkey qfb_bibl_ne ']'

   84 qfb_ctxkey: sym_str qfbc_matchref qfbc_offset
   85           | qfbc_matchref qfbc_offset

   86 qfbc_matchref: /* empty */
   87              | matchref

   88 qfbc_offset: /* empty */
   89            | integer
   90            | '+' integer
   91            | '-' integer

   92 q_clause: qc_basic
   93         | qc_boolean
   94         | qc_concat
   95         | qc_matchid

   96 qc_matchid: q_clause '=' integer
   97           | '(' qc_matchid ')'

   98 qc_boolean: q_clause OP_BOOL_AND q_clause
   99           | q_clause OP_BOOL_OR q_clause
  100           | '!' q_clause
  101           | '(' qc_boolean ')'

  102 qc_concat: qc_basic qc_basic
  103          | qc_concat qc_basic
  104          | '(' qc_concat ')'

  105 qc_basic: qc_tokens
  106         | qc_near

  107 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  108        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  109        | '(' qc_near ')'

  110 qc_tokens: qc_word
  111          | qc_phrase
  112          | qc_tokens '=' integer

  113 qc_phrase: '"' l_phrase '"'
  114          | '(' qc_phrase ')'

  115 qc_word: qw_bareword
  116        | qw_exact
  117        | qw_regex
  118        | qw_any
  119        | qw_set_infl
  120        | qw_set_exact
  121        | qw_infix
  122        | qw_infix_set
  123        | qw_prefix
  124        | qw_prefix_set
  125        | qw_suffix
  126        | qw_suffix_set
  127        | qw_thesaurus
  128        | qw_morph
  129        | qw_lemma
  130        | qw_chunk
  131        | qw_anchor
  132        | qw_listfile
  133        | qw_with
  134        | qw_without
  135        | qw_matchid
  136        | '(' qc_word ')'

  137 qw_bareword: s_word l_txchain
  138            | s_index '=' s_word l_txchain

  139 qw_exact: '@' s_word
  140         | s_index '=' '@' s_word

  141 qw_regex: regex
  142         | s_index '=' regex
  143         | neg_regex
  144         | s_index '=' neg_regex

  145 qw_any: '*'
  146       | s_index '=' '*'

  147 qw_set_exact: AT_LBRACE l_set '}'
  148             | s_index '=' AT_LBRACE l_set '}'

  149 qw_set_infl: '{' l_set '}' l_txchain
  150            | s_index '=' '{' l_set '}' l_txchain

  151 qw_prefix: s_prefix
  152          | s_index '=' s_prefix

  153 qw_suffix: s_suffix
  154          | s_index '=' s_suffix

  155 qw_infix: s_infix
  156         | s_index '=' s_infix

  157 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  158             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  159 qw_prefix_set: '{' l_set RBRACE_STAR
  160              | s_index '=' '{' l_set RBRACE_STAR

  161 qw_suffix_set: STAR_LBRACE l_set '}'
  162              | s_index '=' STAR_LBRACE l_set '}'

  163 qw_thesaurus: COLON_LBRACE s_semclass '}'
  164             | s_index '=' ':' '{' s_semclass '}'

  165 qw_morph: '[' l_morph ']'
  166         | s_index '=' '[' l_morph ']'

  167 qw_lemma: '%' s_lemma
  168         | s_index '=' '%' s_lemma

  169 qw_chunk: '^' s_chunk
  170         | s_index '=' '^' s_chunk

  171 qw_anchor: DOLLAR_DOT '=' int_str
  172          | DOLLAR_DOT symbol '=' int_str

  173 qw_listfile: '<' s_filename
  174            | s_index '=' '<' s_filename

  175 qw_with: qc_word WITH qc_word

  176 qw_without: qc_word WITHOUT qc_word

  177 qw_matchid: qc_word '=' integer

  178 l_set: /* empty */
  179      | l_set s_word
  180      | l_set ','

  181 l_morph: /* empty */
  182        | l_morph s_morphitem
  183        | l_morph ','
  184        | l_morph ';'

  185 l_phrase: qc_word
  186         | l_phrase qc_word
  187         | l_phrase '#' integer qc_word
  188         | l_phrase HASH_LESS integer qc_word
  189         | l_phrase HASH_GREATER integer qc_word
  190         | l_phrase HASH_EQUAL integer qc_word

  191 l_txchain: /* empty */
  192          | l_txchain s_expander

  193 l_countkeys: /* empty */
  194            | l_countkeys ','
  195            | l_countkeys count_key

  196 count_key: '*'
  197          | '@' symbol
  198          | KW_FILEID
  199          | KW_FILENAME
  200          | KW_DATE
  201          | KW_DATE '/' integer
  202          | s_biblname
  203          | count_key '~' replace_regex
  204          | '(' count_key ')'

  205 s_index: '$'
  206        | '$' symbol

  207 s_word: symbol

  208 s_semclass: symbol

  209 s_lemma: symbol

  210 s_chunk: symbol

  211 s_filename: symbol

  212 s_morphitem: symbol

  213 s_subcorpus: symbol

  214 s_biblname: symbol

  215 s_breakname: symbol
  216            | KW_FILENAME

  217 symbol: SYMBOL
  218       | INTEGER
  219       | DATE

  220 sym_str: SYMBOL

  221 s_prefix: PREFIX

  222 s_suffix: SUFFIX

  223 s_infix: INFIX

  224 s_expander: EXPANDER

  225 regex: REGEX
  226      | REGEX REGOPT

  227 neg_regex: NEG_REGEX
  228          | NEG_REGEX REGOPT

  229 replace_regex: REGEX_SEARCH REGEX_REPLACE
  230              | REGEX_SEARCH REGEX_REPLACE REGOPT

  231 int_str: INTEGER

  232 integer: int_str

  233 date: DATE
  234     | INTEGER

  235 matchref: DOLLAR_INT


