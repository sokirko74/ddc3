Terminals unused in grammar

   CONCAT
   '~'


Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions ')' count_filters

    4 count_filters: /* empty */
    5              | count_filters count_filter

    6 count_filter: count_by

    7 count_by: BY l_countkeys
    8         | BY '[' l_countkeys ']'

    9 query_conditions: q_clause q_filters

   10 q_filters: /* empty */
   11          | q_filters q_flag
   12          | q_filters q_filter

   13 q_flag: ':' qf_subcorpora
   14       | CNTXT integer
   15       | WITHIN s_breakname
   16       | SEPARATE_HITS
   17       | NOSEPARATE_HITS
   18       | FILENAMES_ONLY
   19       | '!' FILENAMES_ONLY
   20       | DEBUG_RANK
   21       | '!' DEBUG_RANK

   22 qf_subcorpora: /* empty */
   23              | s_subcorpus
   24              | qf_subcorpora ',' s_subcorpus

   25 q_filter: qf_has_field
   26         | qf_rank_sort
   27         | qf_context_sort
   28         | qf_size_sort
   29         | qf_date_sort
   30         | qf_bibl_sort
   31         | qf_random_sort

   32 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   33             | HAS_FIELD '[' s_biblname ',' regex ']'
   34             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   35             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   36             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   37             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   38             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   39             | '!' qf_has_field

   40 qf_rank_sort: GREATER_BY_RANK
   41             | LESS_BY_RANK

   42 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   43                | GREATER_BY_LEFT qfb_ctxsort
   44                | LESS_BY_RIGHT qfb_ctxsort
   45                | GREATER_BY_RIGHT qfb_ctxsort
   46                | LESS_BY_MIDDLE qfb_ctxsort
   47                | GREATER_BY_MIDDLE qfb_ctxsort

   48 qf_size_sort: LESS_BY_SIZE qfb_int
   49             | GREATER_BY_SIZE qfb_int
   50             | IS_SIZE '[' int_str ']'

   51 qf_date_sort: LESS_BY_DATE qfb_date
   52             | GREATER_BY_DATE qfb_date
   53             | IS_DATE '[' date ']'

   54 qf_random_sort: RANDOM
   55               | RANDOM '[' ']'
   56               | RANDOM '[' int_str ']'

   57 qf_bibl_sort: LESS_BY '[' s_biblname qfb_bibl ']'
   58             | GREATER_BY '[' s_biblname qfb_bibl ']'

   59 qfb_int: /* empty */
   60        | '[' ']'
   61        | '[' int_str ']'
   62        | '[' int_str ',' ']'
   63        | '[' int_str ',' int_str ']'
   64        | '[' ',' int_str ']'

   65 qfb_date: /* empty */
   66         | '[' ']'
   67         | '[' date ']'
   68         | '[' date ',' ']'
   69         | '[' date ',' date ']'
   70         | '[' ',' date ']'

   71 qfb_bibl: /* empty */
   72         | qfb_bibl_ne

   73 qfb_bibl_ne: ','
   74            | ',' ','
   75            | ',' symbol
   76            | ',' symbol ','
   77            | ',' ',' symbol
   78            | ',' symbol ',' symbol

   79 qfb_ctxsort: /* empty */
   80            | '[' ']'
   81            | '[' qfb_bibl_ne ']'
   82            | '[' qfb_ctxkey ']'
   83            | '[' qfb_ctxkey qfb_bibl_ne ']'

   84 qfb_ctxkey: sym_str
   85           | integer
   86           | sym_str integer

   87 q_clause: qc_basic
   88         | qc_boolean
   89         | qc_concat

   90 qc_boolean: q_clause OP_BOOL_AND q_clause
   91           | q_clause OP_BOOL_OR q_clause
   92           | '!' q_clause
   93           | '(' qc_boolean ')'

   94 qc_concat: qc_basic qc_basic
   95          | qc_concat qc_basic
   96          | '(' qc_concat ')'

   97 qc_basic: qc_tokens
   98         | qc_near

   99 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  100        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  101        | '(' qc_near ')'

  102 qc_tokens: qc_word
  103          | qc_phrase

  104 qc_phrase: '"' l_phrase '"'
  105          | '(' qc_phrase ')'

  106 qc_word: qw_bareword
  107        | qw_exact
  108        | qw_regex
  109        | qw_any
  110        | qw_set_infl
  111        | qw_set_exact
  112        | qw_infix
  113        | qw_infix_set
  114        | qw_prefix
  115        | qw_prefix_set
  116        | qw_suffix
  117        | qw_suffix_set
  118        | qw_thesaurus
  119        | qw_morph
  120        | qw_lemma
  121        | qw_chunk
  122        | qw_anchor
  123        | qw_listfile
  124        | qw_with
  125        | '(' qc_word ')'

  126 qw_bareword: s_word l_txchain
  127            | s_index '=' s_word l_txchain

  128 qw_exact: '@' s_word
  129         | s_index '=' '@' s_word

  130 qw_regex: regex
  131         | s_index '=' regex
  132         | neg_regex
  133         | s_index '=' neg_regex

  134 qw_any: '*'
  135       | s_index '=' '*'

  136 qw_set_exact: AT_LBRACE l_set '}'
  137             | s_index '=' AT_LBRACE l_set '}'

  138 qw_set_infl: '{' l_set '}' l_txchain
  139            | s_index '=' '{' l_set '}' l_txchain

  140 qw_prefix: s_prefix
  141          | s_index '=' s_prefix

  142 qw_suffix: s_suffix
  143          | s_index '=' s_suffix

  144 qw_infix: s_infix
  145         | s_index '=' s_infix

  146 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  147             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  148 qw_prefix_set: '{' l_set RBRACE_STAR
  149              | s_index '=' '{' l_set RBRACE_STAR

  150 qw_suffix_set: STAR_LBRACE l_set '}'
  151              | s_index '=' STAR_LBRACE l_set '}'

  152 qw_thesaurus: COLON_LBRACE s_semclass '}'
  153             | s_index '=' ':' '{' s_semclass '}'

  154 qw_morph: '[' l_morph ']'
  155         | s_index '=' '[' l_morph ']'

  156 qw_lemma: '%' s_lemma
  157         | s_index '=' '%' s_lemma

  158 qw_chunk: '^' s_chunk
  159         | s_index '=' '^' s_chunk

  160 qw_anchor: DOLLAR_DOT '=' int_str
  161          | DOLLAR_DOT symbol '=' int_str

  162 qw_listfile: '<' s_filename
  163            | s_index '=' '<' s_filename

  164 qw_with: qc_word WITH qc_word

  165 l_set: /* empty */
  166      | l_set s_word
  167      | l_set ','

  168 l_morph: /* empty */
  169        | l_morph s_morphitem
  170        | l_morph ','
  171        | l_morph ';'

  172 l_phrase: qc_word
  173         | l_phrase qc_word
  174         | l_phrase '#' integer qc_word
  175         | l_phrase HASH_LESS integer qc_word
  176         | l_phrase HASH_GREATER integer qc_word
  177         | l_phrase HASH_EQUAL integer qc_word

  178 l_txchain: /* empty */
  179          | l_txchain s_expander

  180 l_countkeys: /* empty */
  181            | l_countkeys ','
  182            | l_countkeys count_key

  183 count_key: '*'
  184          | '@' symbol
  185          | KW_FILEID
  186          | KW_FILENAME
  187          | KW_DATE
  188          | KW_DATE '/' integer
  189          | s_biblname

  190 s_index: '$'
  191        | '$' symbol

  192 s_word: symbol

  193 s_semclass: symbol

  194 s_lemma: symbol

  195 s_chunk: symbol

  196 s_filename: symbol

  197 s_morphitem: symbol

  198 s_subcorpus: symbol

  199 s_biblname: symbol

  200 s_breakname: symbol

  201 symbol: SYMBOL
  202       | INTEGER
  203       | DATE

  204 sym_str: SYMBOL

  205 s_prefix: PREFIX

  206 s_suffix: SUFFIX

  207 s_infix: INFIX

  208 s_expander: EXPANDER

  209 regex: REGEX
  210      | REGEX REGOPT

  211 neg_regex: NEG_REGEX
  212          | NEG_REGEX REGOPT

  213 int_str: INTEGER

  214 integer: int_str

  215 date: DATE
  216     | INTEGER


