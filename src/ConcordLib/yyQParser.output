State 0

    0 $accept: . query $end

    SYMBOL        shift, and go to state 1
    REGEX         shift, and go to state 2
    NEG_REGEX     shift, and go to state 3
    INTEGER       shift, and go to state 4
    DATE          shift, and go to state 5
    PREFIX        shift, and go to state 6
    SUFFIX        shift, and go to state 7
    INFIX         shift, and go to state 8
    AT_LBRACE     shift, and go to state 9
    COLON_LBRACE  shift, and go to state 10
    STAR_LBRACE   shift, and go to state 11
    DOLLAR_DOT    shift, and go to state 12
    '!'           shift, and go to state 13
    COUNT         shift, and go to state 14
    KEYS          shift, and go to state 15
    NEAR          shift, and go to state 16
    '<'           shift, and go to state 17
    '$'           shift, and go to state 18
    '@'           shift, and go to state 19
    '^'           shift, and go to state 20
    '%'           shift, and go to state 21
    '('           shift, and go to state 22
    '['           shift, and go to state 23
    '{'           shift, and go to state 24
    '"'           shift, and go to state 25
    '*'           shift, and go to state 26

    query             go to state 27
    count_query       go to state 28
    query_conditions  go to state 29
    q_clause          go to state 30
    qc_matchid        go to state 31
    qc_boolean        go to state 32
    qc_concat         go to state 33
    qc_basic          go to state 34
    qc_near           go to state 35
    qc_tokens         go to state 36
    qc_phrase         go to state 37
    qc_word           go to state 38
