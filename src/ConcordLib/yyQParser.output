Terminals unused in grammar

   DOLLAR_DOLLAR
   CONCAT


Grammar

    0 $accept: query $end

    1 query: query_conditions
    2      | count_query

    3 count_query: COUNT '(' query_conditions ')' count_filters

    4 count_filters: /* empty */
    5              | count_filters count_filter

    6 count_filter: count_by

    7 count_by: BY l_countkeys
    8         | BY '[' l_countkeys ']'

    9 query_conditions: q_clause q_filters

   10 q_filters: /* empty */
   11          | q_filters q_flag
   12          | q_filters q_filter

   13 q_flag: ':' qf_subcorpora
   14       | CNTXT integer
   15       | WITHIN s_breakname
   16       | SEPARATE_HITS
   17       | NOSEPARATE_HITS
   18       | FILENAMES_ONLY
   19       | '!' FILENAMES_ONLY
   20       | DEBUG_RANK
   21       | '!' DEBUG_RANK

   22 qf_subcorpora: /* empty */
   23              | s_subcorpus
   24              | qf_subcorpora ',' s_subcorpus

   25 q_filter: qf_has_field
   26         | qf_rank_sort
   27         | qf_context_sort
   28         | qf_size_sort
   29         | qf_date_sort
   30         | qf_bibl_sort
   31         | qf_random_sort

   32 qf_has_field: HAS_FIELD '[' s_biblname ',' symbol ']'
   33             | HAS_FIELD '[' s_biblname ',' regex ']'
   34             | HAS_FIELD '[' s_biblname ',' neg_regex ']'
   35             | HAS_FIELD '[' s_biblname ',' s_prefix ']'
   36             | HAS_FIELD '[' s_biblname ',' s_suffix ']'
   37             | HAS_FIELD '[' s_biblname ',' s_infix ']'
   38             | HAS_FIELD '[' s_biblname ',' '{' l_set '}' ']'
   39             | '!' qf_has_field

   40 qf_rank_sort: GREATER_BY_RANK
   41             | LESS_BY_RANK

   42 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   43                | GREATER_BY_LEFT qfb_ctxsort
   44                | LESS_BY_RIGHT qfb_ctxsort
   45                | GREATER_BY_RIGHT qfb_ctxsort
   46                | LESS_BY_MIDDLE qfb_ctxsort
   47                | GREATER_BY_MIDDLE qfb_ctxsort

   48 qf_size_sort: LESS_BY_SIZE qfb_int
   49             | GREATER_BY_SIZE qfb_int
   50             | IS_SIZE '[' int_str ']'

   51 qf_date_sort: LESS_BY_DATE qfb_date
   52             | GREATER_BY_DATE qfb_date
   53             | IS_DATE '[' date ']'

   54 qf_random_sort: RANDOM
   55               | RANDOM '[' ']'
   56               | RANDOM '[' int_str ']'

   57 qf_bibl_sort: LESS_BY '[' KW_DATE qfb_bibl ']'
   58             | GREATER_BY '[' KW_DATE qfb_bibl ']'
   59             | LESS_BY '[' s_biblname qfb_bibl ']'
   60             | GREATER_BY '[' s_biblname qfb_bibl ']'

   61 qfb_int: /* empty */
   62        | '[' ']'
   63        | '[' int_str ']'
   64        | '[' int_str ',' ']'
   65        | '[' int_str ',' int_str ']'
   66        | '[' ',' int_str ']'

   67 qfb_date: /* empty */
   68         | '[' ']'
   69         | '[' date ']'
   70         | '[' date ',' ']'
   71         | '[' date ',' date ']'
   72         | '[' ',' date ']'

   73 qfb_bibl: /* empty */
   74         | qfb_bibl_ne

   75 qfb_bibl_ne: ','
   76            | ',' ','
   77            | ',' symbol
   78            | ',' symbol ','
   79            | ',' ',' symbol
   80            | ',' symbol ',' symbol

   81 qfb_ctxsort: /* empty */
   82            | '[' ']'
   83            | '[' qfb_bibl_ne ']'
   84            | '[' qfb_ctxkey ']'
   85            | '[' qfb_ctxkey qfb_bibl_ne ']'

   86 qfb_ctxkey: sym_str
   87           | integer
   88           | sym_str integer

   89 q_clause: qc_basic
   90         | qc_boolean
   91         | qc_concat

   92 qc_boolean: q_clause OP_BOOL_AND q_clause
   93           | q_clause OP_BOOL_OR q_clause
   94           | '!' q_clause
   95           | '(' qc_boolean ')'

   96 qc_concat: qc_basic qc_basic
   97          | qc_concat qc_basic
   98          | '(' qc_concat ')'

   99 qc_basic: qc_tokens
  100         | qc_near

  101 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
  102        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
  103        | '(' qc_near ')'

  104 qc_tokens: qc_word
  105          | qc_phrase

  106 qc_phrase: '"' l_phrase '"'
  107          | '(' qc_phrase ')'

  108 qc_word: qw_bareword
  109        | qw_exact
  110        | qw_regex
  111        | qw_any
  112        | qw_set_infl
  113        | qw_set_exact
  114        | qw_infix
  115        | qw_infix_set
  116        | qw_prefix
  117        | qw_prefix_set
  118        | qw_suffix
  119        | qw_suffix_set
  120        | qw_thesaurus
  121        | qw_morph
  122        | qw_lemma
  123        | qw_chunk
  124        | qw_anchor
  125        | qw_listfile
  126        | qw_with
  127        | qw_without
  128        | qw_matchid
  129        | '(' qc_word ')'

  130 qw_bareword: s_word l_txchain
  131            | s_index '=' s_word l_txchain

  132 qw_exact: '@' s_word
  133         | s_index '=' '@' s_word

  134 qw_regex: regex
  135         | s_index '=' regex
  136         | neg_regex
  137         | s_index '=' neg_regex

  138 qw_any: '*'
  139       | s_index '=' '*'

  140 qw_set_exact: AT_LBRACE l_set '}'
  141             | s_index '=' AT_LBRACE l_set '}'

  142 qw_set_infl: '{' l_set '}' l_txchain
  143            | s_index '=' '{' l_set '}' l_txchain

  144 qw_prefix: s_prefix
  145          | s_index '=' s_prefix

  146 qw_suffix: s_suffix
  147          | s_index '=' s_suffix

  148 qw_infix: s_infix
  149         | s_index '=' s_infix

  150 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  151             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  152 qw_prefix_set: '{' l_set RBRACE_STAR
  153              | s_index '=' '{' l_set RBRACE_STAR

  154 qw_suffix_set: STAR_LBRACE l_set '}'
  155              | s_index '=' STAR_LBRACE l_set '}'

  156 qw_thesaurus: COLON_LBRACE s_semclass '}'
  157             | s_index '=' ':' '{' s_semclass '}'

  158 qw_morph: '[' l_morph ']'
  159         | s_index '=' '[' l_morph ']'

  160 qw_lemma: '%' s_lemma
  161         | s_index '=' '%' s_lemma

  162 qw_chunk: '^' s_chunk
  163         | s_index '=' '^' s_chunk

  164 qw_anchor: DOLLAR_DOT '=' int_str
  165          | DOLLAR_DOT symbol '=' int_str

  166 qw_listfile: '<' s_filename
  167            | s_index '=' '<' s_filename

  168 qw_with: qc_word WITH qc_word

  169 qw_without: qc_word WITHOUT qc_word

  170 qw_matchid: qc_word '=' integer

  171 l_set: /* empty */
  172      | l_set s_word
  173      | l_set ','

  174 l_morph: /* empty */
  175        | l_morph s_morphitem
  176        | l_morph ','
  177        | l_morph ';'

  178 l_phrase: qc_word
  179         | l_phrase qc_word
  180         | l_phrase '#' integer qc_word
  181         | l_phrase HASH_LESS integer qc_word
  182         | l_phrase HASH_GREATER integer qc_word
  183         | l_phrase HASH_EQUAL integer qc_word

  184 l_txchain: /* empty */
  185          | l_txchain s_expander

  186 l_countkeys: /* empty */
  187            | l_countkeys ','
  188            | l_countkeys count_key

  189 count_key: '*'
  190          | '@' symbol
  191          | KW_FILEID
  192          | KW_FILENAME
  193          | KW_DATE
  194          | KW_DATE '/' integer
  195          | s_biblname
  196          | count_key '~' replace_regex
  197          | '(' count_key ')'

  198 s_index: '$'
  199        | '$' symbol

  200 s_word: symbol

  201 s_semclass: symbol

  202 s_lemma: symbol

  203 s_chunk: symbol

  204 s_filename: symbol

  205 s_morphitem: symbol

  206 s_subcorpus: symbol

  207 s_biblname: symbol

  208 s_breakname: symbol
  209            | KW_FILENAME

  210 symbol: SYMBOL
  211       | INTEGER
  212       | DATE

  213 sym_str: SYMBOL

  214 s_prefix: PREFIX

  215 s_suffix: SUFFIX

  216 s_infix: INFIX

  217 s_expander: EXPANDER

  218 regex: REGEX
  219      | REGEX REGOPT

  220 neg_regex: NEG_REGEX
  221          | NEG_REGEX REGOPT

  222 replace_regex: REGEX_SEARCH REGEX_REPLACE
  223              | REGEX_SEARCH REGEX_REPLACE REGOPT

  224 int_str: INTEGER

  225 integer: int_str

  226 date: DATE
  227     | INTEGER


