Terminals unused in grammar

   CONCAT


Grammar

    0 $accept: query $end

    1 query: q_clause q_filters

    2 q_filters: /* empty */
    3          | q_filters q_flag
    4          | q_filters q_filter

    5 q_flag: ':' qf_subcorpora
    6       | CNTXT integer
    7       | WITHIN symbol
    8       | SEPARATE_HITS
    9       | NOSEPARATE_HITS
   10       | FILENAMES_ONLY
   11       | '!' FILENAMES_ONLY
   12       | DEBUG_RANK
   13       | '!' DEBUG_RANK

   14 qf_subcorpora: /* empty */
   15              | s_subcorpus
   16              | qf_subcorpora ',' s_subcorpus

   17 q_filter: qf_has_field
   18         | qf_rank_sort
   19         | qf_context_sort
   20         | qf_size_sort
   21         | qf_date_sort
   22         | qf_bibl_sort
   23         | qf_random_sort

   24 qf_has_field: HAS_FIELD '[' symbol ',' symbol ']'
   25             | HAS_FIELD '[' symbol ',' regex ']'
   26             | HAS_FIELD '[' symbol ',' neg_regex ']'
   27             | HAS_FIELD '[' symbol ',' s_prefix ']'
   28             | HAS_FIELD '[' symbol ',' s_suffix ']'
   29             | HAS_FIELD '[' symbol ',' s_infix ']'
   30             | HAS_FIELD '[' symbol ',' '{' l_set '}' ']'
   31             | '!' qf_has_field

   32 qf_rank_sort: GREATER_BY_RANK
   33             | LESS_BY_RANK

   34 qf_context_sort: LESS_BY_LEFT qfb_ctxsort
   35                | GREATER_BY_LEFT qfb_ctxsort
   36                | LESS_BY_RIGHT qfb_ctxsort
   37                | GREATER_BY_RIGHT qfb_ctxsort
   38                | LESS_BY_CONTEXT qfb_ctxsort
   39                | GREATER_BY_CONTEXT qfb_ctxsort

   40 qf_size_sort: LESS_BY_SIZE qfb_int
   41             | GREATER_BY_SIZE qfb_int
   42             | IS_SIZE '[' int_str ']'

   43 qf_date_sort: LESS_BY_DATE qfb_date
   44             | GREATER_BY_DATE qfb_date
   45             | IS_DATE '[' date ']'

   46 qf_random_sort: RANDOM
   47               | RANDOM '[' ']'
   48               | RANDOM '[' int_str ']'

   49 qf_bibl_sort: LESS_BY '[' symbol qfb_bibl ']'
   50             | GREATER_BY '[' symbol qfb_bibl ']'

   51 qfb_int: /* empty */
   52        | '[' ']'
   53        | '[' int_str ']'
   54        | '[' int_str ',' ']'
   55        | '[' int_str ',' int_str ']'
   56        | '[' ',' int_str ']'

   57 qfb_date: /* empty */
   58         | '[' ']'
   59         | '[' date ']'
   60         | '[' date ',' ']'
   61         | '[' date ',' date ']'
   62         | '[' ',' date ']'

   63 qfb_bibl: /* empty */
   64         | qfb_bibl_ne

   65 qfb_bibl_ne: ','
   66            | ',' ','
   67            | ',' symbol
   68            | ',' symbol ','
   69            | ',' ',' symbol
   70            | ',' symbol ',' symbol

   71 qfb_ctxsort: /* empty */
   72            | '[' qfb_ctxkey ']'
   73            | '[' qfb_bibl_ne ']'
   74            | '[' qfb_ctxkey qfb_bibl_ne ']'

   75 qfb_ctxkey: sym_str
   76           | integer
   77           | sym_str integer

   78 q_clause: qc_basic
   79         | qc_boolean
   80         | qc_concat

   81 qc_boolean: q_clause OP_AND q_clause
   82           | q_clause OP_OR q_clause
   83           | '!' q_clause
   84           | '(' qc_boolean ')'

   85 qc_concat: qc_basic qc_basic
   86          | qc_concat qc_basic
   87          | '(' qc_concat ')'

   88 qc_basic: qc_tokens
   89         | qc_near

   90 qc_near: NEAR '(' qc_tokens ',' qc_tokens ',' integer ')'
   91        | NEAR '(' qc_tokens ',' qc_tokens ',' qc_tokens ',' integer ')'
   92        | '(' qc_near ')'

   93 qc_tokens: qc_word
   94          | qc_phrase

   95 qc_phrase: '"' l_phrase '"'
   96          | '(' qc_phrase ')'

   97 qc_word: qw_bareword
   98        | qw_exact
   99        | qw_regex
  100        | qw_any
  101        | qw_set_infl
  102        | qw_set_exact
  103        | qw_infix
  104        | qw_infix_set
  105        | qw_prefix
  106        | qw_prefix_set
  107        | qw_suffix
  108        | qw_suffix_set
  109        | qw_thesaurus
  110        | qw_morph
  111        | qw_lemma
  112        | qw_chunk
  113        | qw_anchor
  114        | qw_listfile
  115        | qw_with
  116        | '(' qc_word ')'

  117 qw_bareword: s_word l_txchain
  118            | s_index '=' s_word l_txchain

  119 qw_exact: '@' s_word
  120         | s_index '=' '@' s_word

  121 qw_regex: regex
  122         | s_index '=' regex
  123         | neg_regex
  124         | s_index '=' neg_regex

  125 qw_any: '*'
  126       | s_index '=' '*'

  127 qw_set_exact: AT_LBRACE l_set '}'
  128             | s_index '=' AT_LBRACE l_set '}'

  129 qw_set_infl: '{' l_set '}' l_txchain
  130            | s_index '=' '{' l_set '}' l_txchain

  131 qw_prefix: s_prefix
  132          | s_index '=' s_prefix

  133 qw_suffix: s_suffix
  134          | s_index '=' s_suffix

  135 qw_infix: s_infix
  136         | s_index '=' s_infix

  137 qw_infix_set: STAR_LBRACE l_set RBRACE_STAR
  138             | s_index '=' STAR_LBRACE l_set RBRACE_STAR

  139 qw_prefix_set: '{' l_set RBRACE_STAR
  140              | s_index '=' '{' l_set RBRACE_STAR

  141 qw_suffix_set: STAR_LBRACE l_set '}'
  142              | s_index '=' STAR_LBRACE l_set '}'

  143 qw_thesaurus: COLON_LBRACE s_semclass '}'
  144             | s_index '=' ':' '{' s_semclass '}'

  145 qw_morph: '[' l_morph ']'
  146         | s_index '=' '[' l_morph ']'

  147 qw_lemma: '%' s_lemma
  148         | s_index '=' '%' s_lemma

  149 qw_chunk: '^' s_chunk
  150         | s_index '=' '^' s_chunk

  151 qw_anchor: DOLLAR_DOT '=' int_str
  152          | DOLLAR_DOT symbol '=' int_str

  153 qw_listfile: '<' s_filename
  154            | s_index '=' '<' s_filename

  155 qw_with: qc_word WITH qc_word

  156 l_set: /* empty */
  157      | l_set s_word
  158      | l_set ','

  159 l_morph: /* empty */
  160        | l_morph s_morphitem
  161        | l_morph ','
  162        | l_morph ';'

  163 l_phrase: qc_word
  164         | l_phrase qc_word
  165         | l_phrase '#' integer qc_word
  166         | l_phrase HASH_LESS integer qc_word
  167         | l_phrase HASH_GREATER integer qc_word
  168         | l_phrase HASH_EQUAL integer qc_word

  169 l_txchain: /* empty */
  170          | l_txchain s_expander

  171 s_index: '$'
  172        | '$' symbol

  173 s_word: symbol

  174 s_semclass: symbol

  175 s_lemma: symbol

  176 s_chunk: symbol

  177 s_filename: symbol

  178 s_morphitem: symbol

  179 s_subcorpus: symbol

  180 symbol: SYMBOL
  181       | INTEGER
  182       | DATE

  183 sym_str: SYMBOL

  184 s_prefix: PREFIX

  185 s_suffix: SUFFIX

  186 s_infix: INFIX

  187 s_expander: EXPANDER

  188 regex: REGEX
  189      | REGEX REGOPT

  190 neg_regex: NEG_REGEX
  191          | NEG_REGEX REGOPT

  192 int_str: INTEGER

  193 integer: int_str

  194 date: DATE
  195     | INTEGER


