ifeq ($(libmode), shared)

$(LibName).$(lib_ext) : $(objects)
	$(mode_error)
	g++ -$(libmode)  -o $@ $^
	cp $@ $(RML)/Bin

else

$(LibName).$(lib_ext) : $(objects)
	$(mode_error)
	ar rcs  $@  $^
endif

#$(precomp): %.h.gch : %.h
#	echo "test"
#	g++ $(cparams) $< -o $@

$(objects): %.o$(ct) : %.cpp
	$(mode_error)
	g++ $(cparams) $< -o $@


include $(wildcard *.d)

clean : ;
	-rm $(objects)
	-rm $(LibName).$(lib_ext)
	-rm *.d
	


objects:
	@echo "$(objects)"

sources:
	for f in $(objects); do \
	  b="$${f%.*}" ;\
	  test -f "$$b.cpp" && echo -n " $$b.cpp" ;\
	  test -f "$$b.h" && echo -n " $$b.h" ;\
	  echo " \\";\
	done
